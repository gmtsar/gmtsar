#! /usr/bin/env python3
"""SAT_llt2rat_py — Python port of the gmtsar C binary SAT_llt2rat.

Maps a DEM's (lon, lat, h) triplets to (range_pixel, azimuth_pixel,
height, lon, lat) using the satellite's orbital state from the LED
file and radar parameters from the master PRM file.

Algorithm (mirrors SAT_llt2rat.c):
  for each xyz input point:
    1. plh2xyz: (lat, lon, h) -> ECEF (xp, yp, zp)
    2. goldop: golden-section search for time-of-closest-approach of
       the satellite to (xp, yp, zp), against a pre-sampled orbit grid.
    3. polyfit refinement (when -p 1): fit 2nd-order polynomial to
       range(time) in a 1-s window around the gold-section minimum.
    4. Convert (range, time) to pixel coordinates via PRM constants.
    5. Optional Doppler correction (when fd1 != 0).
    6. Write 5-double row: (range_pix, azi_pix, height, lon, lat).

Decomposed into checkpoints C1..C8 (one section each, tested
independently). See PYGMT_ROADMAP.md / bin_py/README.md for context.

CLI:
    SAT_llt2rat_py master.PRM precise [-bos|-bod]
        precise: 0 (gold-only) or 1 (gold + polyfit refine)
        -bos: single-precision 5-float binary stdout
        -bod: double-precision 5-double binary stdout
"""
from __future__ import annotations

import argparse
import os
import sys

import numpy as np

# ---------------------------------------------------------- Numba (optional) ---
# Numba is an OPTIONAL accelerator. Setting SAT_LLT2RAT_PY_NUMBA=0 disables it
# even when numba is installed. Default is "on if installed". All JIT kernels
# are line-by-line ports of the pure-numpy reference paths above; they mirror
# C evaluation order (Mira #2 bugs #3..#9) and use fastmath=False, single-thread,
# no prange. If numba is missing OR disabled, all callers fall through to the
# pure-numpy paths and parity is unchanged.
_NUMBA_ENV = os.environ.get("SAT_LLT2RAT_PY_NUMBA", "1")
if _NUMBA_ENV == "0":
    _HAS_NUMBA = False
    njit = None
    prange = range  # type: ignore[assignment]
else:
    try:
        from numba import njit, prange                          # type: ignore
        _HAS_NUMBA = True
    except ImportError:                                         # pragma: no cover
        _HAS_NUMBA = False
        njit = None
        prange = range  # type: ignore[assignment]


SOL = 299792456.0   # speed of light, m/s — MATCHES C `#define SOL` in
                    # gmtsar.h (NOT the true physical 299792458). 2 m/s off,
                    # but bit-faithful parity with C requires this exact value.
                    # Affects dr = 0.5*SOL/fs → ~2e-5 px range_pix systematic offset.
# C uses TRUNCATED golden-ratio constants (R + C = 0.99996601, NOT 1.0):
#   #define R 0.61803399
#   #define C 0.382
# These two values get baked into goldop (search step sizes) and main()
# (midi computation), so for bit-perfect parity we use the SAME truncated
# values, NOT the mathematically correct (1 - C_GOLD) etc.
R_GOLD_C = 0.61803399          # C #define R
C_GOLD = 0.382                  # C #define C


# ---------------------------------------------------------- C1 read PRM/LED ---
def read_prm(path: str) -> dict:
    """Parse a gmtsar PRM file into a dict of string values."""
    out: dict[str, str] = {}
    with open(path) as f:
        for line in f:
            if "=" not in line:
                continue
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    return out


def _prm_f(prm: dict, key: str, default: float = 0.0) -> float:
    v = prm.get(key, "").split()
    return float(v[0]) if v else default


def _prm_i(prm: dict, key: str, default: int = 0) -> int:
    return int(_prm_f(prm, key, default))


def _prm_s(prm: dict, key: str, default: str = "") -> str:
    v = prm.get(key, "").split()
    return v[0] if v else default


def read_led(path: str) -> tuple[dict, np.ndarray]:
    """Parse a gmtsar LED orbit file (ASCII).

    Returns:
      meta:   {nd, iy, id, sec, dsec}
      orbit:  (nd, 4) array: [t, px, py, pz] (s, m, m, m). Velocities
              available but not returned; could add if needed.
    """
    with open(path) as f:
        first = f.readline().split()
        if len(first) < 5:
            raise ValueError(f"{path}: header line malformed")
        nd, iy, id_, sec, dsec = (int(first[0]), int(first[1]),
                                  int(first[2]), float(first[3]),
                                  float(first[4]))
        rows = []
        for line in f:
            parts = line.split()
            if len(parts) < 9:
                continue
            # LED record: iy id sec px py pz vx vy vz
            # The `sec` field is "seconds since midnight of day `id`".
            # Convert to absolute "seconds since start of year" so the
            # orbit times share a coordinate frame with the driver's
            # t1 = 86400 * clock_start (clock_start is day-of-year +
            # fractional day). Matches C calorb_alos:
            #   pt0 = 86400 * orb->id + orb->sec
            row_id = int(parts[1])
            row_sec_of_day = float(parts[2])
            t_abs = 86400.0 * row_id + row_sec_of_day
            rows.append([t_abs,                  # t (sec-of-year)
                         float(parts[3]),        # px
                         float(parts[4]),        # py
                         float(parts[5]),        # pz
                         float(parts[6]),        # vx
                         float(parts[7]),        # vy
                         float(parts[8])])       # vz
    orbit = np.array(rows, dtype=np.float64)
    return ({"nd": nd, "iy": iy, "id": id_, "sec": sec, "dsec": dsec},
            orbit)


# ---------------------------------------------------------- C2 plh2xyz ---
def plh2xyz(lat: np.ndarray, lon: np.ndarray, h: np.ndarray,
            ra: float, flattening: float) -> np.ndarray:
    """Geodetic (lat, lon, height) to ECEF (x, y, z).

    Bit-faithful port of gmtsar plxyz.c plh2xyz() — mirrors the C
    operation order EXACTLY (the algebraic equivalents differ by 1 ULP):

        flatfn = (2 - FL) * FL
        funsq  = (1 - FL) * (1 - FL)   # NOT (1 - e2); they differ by 1 ULP
        g1 = A / sqrt(1 - flatfn * sin_lat^2)     # N
        g2 = g1 * funsq + h                       # N*(1-FL)^2 + h  (order matters)
        g1 = g1 + h                               # N + h
        xyz[0] = g1 * cos(lat)
        xyz[1] = xyz[0] * sin(lon)                # = (g1*cos_lat) * sin_lon
        xyz[0] = xyz[0] * cos(lon)                # = (g1*cos_lat) * cos_lon
        xyz[2] = g2 * sin_lat

    Accepts scalars or numpy arrays; broadcasts. lat/lon in DEGREES.

    The previous Python form `(1 - e2)*N + h` differs from C
    `g1*funsq + h` by ~1e-9 m due to (1-FL)*(1-FL) vs 1 - 2*FL + FL*FL
    differing by 1 ULP. This propagated to ~1.5e-8 m in xp, which fed
    back through goldop's dist² compare at the rng-vs-tm minimum and
    flipped 20-376 (depending on Hermite path) edge-case branches.
    """
    # GMTSAR uses TRUNCATED pi: `#define pi 3.14159265358979` (llt2xyz.h
    # line 63) — 14 digits, NOT math.pi's 15 digits. That gives
    # `deg_to_rad = 2*pi/360 = 0.017453292519943278` vs numpy's
    # 0.017453292519943295. The 1-ULP diff propagates to ~5e-9 rad at
    # mid-latitudes → ~1.5e-8 m in xyz → flipped goldop branches on
    # 20+ edge-case targets near the rng-vs-tm minimum.
    _PI_GMTSAR = 3.14159265358979
    _DEG_TO_RAD = 2.0 * _PI_GMTSAR / 360.0

    flatfn = (2.0 - flattening) * flattening
    funsq = (1.0 - flattening) * (1.0 - flattening)
    lat_r = lat * _DEG_TO_RAD
    lon_r = lon * _DEG_TO_RAD
    sin_lat = np.sin(lat_r)
    cos_lat = np.cos(lat_r)
    g1 = ra / np.sqrt(1.0 - flatfn * sin_lat * sin_lat)
    g2 = g1 * funsq + h
    g1 = g1 + h
    x = g1 * cos_lat
    y = x * np.sin(lon_r)
    x = x * np.cos(lon_r)
    z = g2 * sin_lat
    return np.stack([x, y, z], axis=-1)


# ---------------------------------------------------------- C3 Hermite interp ---
# Hermite basis cache: for uniform-grid orbit (always true in gmtsar),
# the basis polynomials hj_i(u) and the scalars S_i depend only on
# (nval, i). Precompute them once.
_HERM_CACHE: dict[int, tuple[np.ndarray, np.ndarray]] = {}

def _hermite_basis(nval: int) -> tuple[np.ndarray, np.ndarray]:
    """Returns (HJ_COEFS, S_VALS):
      HJ_COEFS[i, k] = coefficient of u^k in hj_i(u) (i in 0..nval-1)
      S_VALS[i]       = sum_{j!=i} 1/(i-j)
    """
    cached = _HERM_CACHE.get(nval)
    if cached is not None:
        return cached
    n = nval - 1
    HJ = np.zeros((nval, nval), dtype=np.float64)   # row i = polynomial of degree n
    S_VALS = np.zeros(nval, dtype=np.float64)
    for i in range(nval):
        # poly(u) = prod_{j != i} (u - j) / (i - j)
        # Build numerator polynomial from roots [j for j != i]
        roots = [j for j in range(nval) if j != i]
        # numpy poly takes roots → leading coefficient first, descending
        num_poly_desc = np.poly(roots)  # length nval
        # Convert to ascending [c0 + c1*u + c2*u^2 ...]
        num_poly_asc = num_poly_desc[::-1]
        denom = 1.0
        for j in roots:
            denom *= (i - j)
        HJ[i, :] = num_poly_asc / denom
        S_VALS[i] = sum(1.0 / (i - j) for j in roots)
    _HERM_CACHE[nval] = (HJ, S_VALS)
    return HJ, S_VALS


def hermite_c_1d_uniform(x0: float, dsec: float, y: np.ndarray, z: np.ndarray,
                         xp: np.ndarray, nval: int = 6) -> np.ndarray:
    """Optimised hermite_c_1d for uniform-grid x: x[k] = x0 + k * dsec.

    For uniform grids, the Lagrange basis hj_i(u) and S_i = sum 1/(i-j)
    are constant polynomials in u = (xp - x[i0])/dsec. Pre-evaluating
    them avoids the 36 numpy ops per query in the general version.

    On the 97.8 M-query polyfit_refine path this drops hermite from
    ~100 s to ~3 s.
    """
    xp = np.atleast_1d(np.asarray(xp, dtype=np.float64))
    nmax = y.size
    n = nval - 1

    # i = first index s.t. x[i] >= xp  → for uniform: i = ceil((xp - x0)/dsec)
    raw = (xp - x0) / dsec
    i = np.ceil(raw).astype(np.int64)
    # bounds check
    if (raw < 0).any() or (raw > nmax - 1).any():
        raise ValueError(
            f"hermite_c_1d_uniform: xp out of range "
            f"({xp.min()} .. {xp.max()} vs {x0} .. {x0 + (nmax-1)*dsec})")
    i0 = i - (n + 1) // 2
    np.clip(i0, 0, nmax - n - 1, out=i0)

    u = (xp - (x0 + i0 * dsec)) / dsec  # = raw - i0; (M,)

    HJ, S_VALS = _hermite_basis(nval)
    # Evaluate each hj_i(u) for all queries.  Polyval (Horner) on ascending coefs.
    # hj_eval[i, m] = hj_i(u[m])
    M = xp.size
    hj_eval = np.empty((nval, M), dtype=np.float64)
    for i_idx in range(nval):
        v = np.zeros_like(u)
        # Horner ascending: c0 + u*(c1 + u*(c2 + ...))
        for k in range(nval - 1, -1, -1):
            v = v * u + HJ[i_idx, k]
        hj_eval[i_idx] = v
    hj_sq = hj_eval * hj_eval  # (nval, M)

    # Gather y[i0+i], z[i0+i]
    idx = i0[None, :] + np.arange(nval)[:, None]    # (nval, M)
    y_loc = y[idx]
    z_loc = z[idx]
    # f0_i = 1 - 2*(u - i)*S_i; f1_i = (u - i)*dsec
    i_arr = np.arange(nval, dtype=np.float64)[:, None]
    u_minus_i = u[None, :] - i_arr                  # (nval, M)
    f0 = 1.0 - 2.0 * u_minus_i * S_VALS[:, None]   # (nval, M)
    f1 = u_minus_i * dsec                           # (nval, M)
    yp = ((y_loc * f0 + z_loc * f1) * hj_sq).sum(axis=0)
    return yp


# ---------- Numba JIT kernel for hermite_c_1d_uniform (Horner fast path) ----
# Mirrors the pure-numpy hermite_c_1d_uniform above op-for-op:
#   - same Horner reduction order over coefs (descending k)
#   - same per-query u, idx, f0, f1, hj_sq layout
#   - sum over i (in the inner loop here) accumulates in the SAME order
#     as numpy's (y_loc*f0 + z_loc*f1)*hj_sq sum-over-axis=0:
#       for i in 0..nval-1: yp += (y[i0+i]*f0_i + z[i0+i]*f1_i) * hj_sq_i
#     numpy `(... ).sum(axis=0)` also reduces in ascending-i order at this
#     small N (nval=6, BLAS doesn't kick in), so the order matches.
# Used by polyfit_refine_batch (via hermite_orbit) where the AUDIT documents
# a known 1e-6 m residual vs C — that residual is from Horner basis vs C's
# direct Lagrange, NOT from numpy-vs-numba differences. This kernel preserves
# the numpy result bit-for-bit so the precise=1 azi_pix max|d|=2.4e-6 doesn't
# get worse.
if _HAS_NUMBA:
    # parallel=True + prange over query points: per-query state (i, i0, u, yp)
    # is iteration-local; the only writes are to yp_out[m] (disjoint indices).
    # No cross-iteration FP reduction → bit-identical to single-thread, and
    # the per-target Horner basis sum order inside the loop is preserved.
    @njit(cache=False, fastmath=False, parallel=True)
    def _hermite_c_1d_uniform_jit(x0, dsec, y, z, xp, nval,
                                  HJ, S_VALS, yp_out):
        nmax = y.shape[0]
        n = nval - 1
        clip_max = nmax - n - 1
        M = xp.shape[0]
        for m in prange(M):
            xpm = xp[m]
            raw = (xpm - x0) / dsec
            # i = ceil(raw)
            i = int(np.ceil(raw))
            i0 = i - (n + 1) // 2
            if i0 < 0:
                i0 = 0
            elif i0 > clip_max:
                i0 = clip_max
            u = raw - i0   # (xpm - (x0 + i0*dsec))/dsec, algebraically identical
            yp = 0.0
            for i_idx in range(nval):
                # Horner ascending (Mira's basis): v = 0; for k = nval-1..0: v = v*u + HJ[i_idx,k]
                v = 0.0
                for k in range(nval - 1, -1, -1):
                    v = v * u + HJ[i_idx, k]
                hj_sq = v * v
                u_minus_i = u - float(i_idx)
                f0 = 1.0 - 2.0 * u_minus_i * S_VALS[i_idx]
                f1 = u_minus_i * dsec
                yp = yp + (y[i0 + i_idx] * f0 + z[i0 + i_idx] * f1) * hj_sq
            yp_out[m] = yp


def hermite_c_1d_uniform_numba(x0: float, dsec: float, y: np.ndarray,
                               z: np.ndarray, xp: np.ndarray,
                               nval: int = 6) -> np.ndarray:
    """Numba-accelerated wrapper around _hermite_c_1d_uniform_jit.

    Falls back to pure-numpy hermite_c_1d_uniform when numba is unavailable.
    """
    if not _HAS_NUMBA:
        return hermite_c_1d_uniform(x0, dsec, y, z, xp, nval)
    xp = np.ascontiguousarray(np.atleast_1d(xp), dtype=np.float64)
    y = np.ascontiguousarray(y, dtype=np.float64)
    z = np.ascontiguousarray(z, dtype=np.float64)
    nmax = y.size
    # bounds check (match pure-numpy behaviour)
    raw_min = (xp.min() - x0) / dsec
    raw_max = (xp.max() - x0) / dsec
    if raw_min < 0 or raw_max > nmax - 1:
        raise ValueError(
            f"hermite_c_1d_uniform: xp out of range "
            f"({xp.min()} .. {xp.max()} vs {x0} .. {x0 + (nmax-1)*dsec})")
    HJ, S_VALS = _hermite_basis(nval)
    out = np.empty(xp.shape[0], dtype=np.float64)
    _hermite_c_1d_uniform_jit(float(x0), float(dsec), y, z, xp, int(nval),
                              HJ, S_VALS, out)
    return out


def hermite_c_1d(x: np.ndarray, y: np.ndarray, z: np.ndarray,
                 xp: np.ndarray, nval: int = 6) -> np.ndarray:
    """Vectorized bit-faithful port of gmtsar's hermite_c.c.

    Hermite interpolation by a polynomial using `nval` of `nmax` given
    data points (function values + derivatives). Mirrors the C exactly:

        for i in 0..n (n = nval-1):
            sj = sum over j != i of 1/(x[i+i0] - x[j+i0])
            hj = prod over j != i of (xp - x[j+i0])/(x[i+i0] - x[j+i0])
            f0 = 1 - 2*(xp - x[i+i0])*sj
            f1 = xp - x[i+i0]
            yp += (y[i+i0]*f0 + z[i+i0]*f1) * hj * hj

    Args:
        x:    (nmax,) knot positions. Need NOT be uniform (general impl).
        y:    (nmax,) function values
        z:    (nmax,) derivatives
        xp:   (M,) query positions
        nval: number of points used per query (default 6)

    Returns: (M,) interpolated values
    """
    x = np.asarray(x, dtype=np.float64)
    y = np.asarray(y, dtype=np.float64)
    z = np.asarray(z, dtype=np.float64)
    xp = np.atleast_1d(np.asarray(xp, dtype=np.float64))
    nmax = x.size
    n = nval - 1
    if (xp < x[0]).any() or (xp > x[nmax - 1]).any():
        raise ValueError(
            "hermite_c: interpolation point outside data constraints "
            f"({xp.min()} .. {xp.max()} vs {x[0]} .. {x[nmax-1]})")
    # C: find first i with x[i] >= xp. searchsorted side='left' gives that.
    i = np.searchsorted(x, xp, side="left")
    # i0 = i - (n+1)/2  (integer division in C, same here)
    i0 = i - (n + 1) // 2
    # C: clip i0 to [0, nmax - n - 1]
    np.clip(i0, 0, nmax - n - 1, out=i0)

    # Gather (M, nval) sub-arrays.  idx[m, ii] = i0[m] + ii
    idx = i0[:, None] + np.arange(n + 1)[None, :]   # (M, nval)
    x_loc = x[idx]                                  # (M, nval)
    y_loc = y[idx]
    z_loc = z[idx]

    yp = np.zeros_like(xp, dtype=np.float64)
    for ii in range(n + 1):
        xi = x_loc[:, ii]                  # (M,) — x[i+i0]
        # Build hj and sj over j in 0..n, j != ii. Done explicitly to
        # match the C loop semantics (no clever tricks for non-uniform x).
        hj = np.ones_like(xp)
        sj = np.zeros_like(xp)
        for jj in range(n + 1):
            if jj == ii:
                continue
            xj = x_loc[:, jj]
            # C order: hj = hj * (xp - x[j+i0]) / (x[i+i0] - x[j+i0])
            # left-to-right: ((hj * (xp - x_j)) / (xi - x_j))
            # NOT hj *= (xp-xj)/(xi-xj) which is `hj * ((xp-xj)/(xi-xj))` — 1 ULP off.
            hj = (hj * (xp - xj)) / (xi - xj)
            sj += 1.0 / (xi - xj)
        f0 = 1.0 - 2.0 * (xp - xi) * sj
        f1 = xp - xi
        # C: yp = yp + (y * f0 + z * f1) * hj * hj — left-associative,
        # so the trailing `* hj * hj` is `(... * hj) * hj`, NOT `* (hj*hj)`.
        # The 1-ULP roundoff difference matters for goldop branch parity.
        yp = yp + (y_loc[:, ii] * f0 + z_loc[:, ii] * f1) * hj * hj
    return yp


# ---------- Numba JIT kernel for hermite_c_1d (general, non-Horner) -----------
# Line-by-line mirror of the pure-numpy hermite_c_1d above, which itself
# line-by-line mirrors C hermite_c.c (file:gmtsar/hermite_c.c). Inner loops
# preserve C's left-associative arithmetic:
#   hj = (hj * (xp - x[j+i0])) / (x[i+i0] - x[j+i0])   (Mira bug #5)
#   yp = yp + (y*f0 + z*f1) * hj * hj                  (left-assoc * hj * hj)
# Single-thread, fastmath=False, plain `range`. nval is treated as runtime int
# so the same compiled body handles nval=6 (the only one gmtsar uses) without
# specialisation.
if _HAS_NUMBA:
    # parallel=True + prange over query points: per-query state is
    # iteration-local; writes to yp_out[m] are disjoint. Inner ii/jj sums and
    # the bisect search are per-iteration only, so no cross-thread state.
    @njit(cache=False, fastmath=False, parallel=True)
    def _hermite_c_1d_jit(x, y, z, xp, nval, yp_out):                # noqa: D401
        nmax = x.shape[0]
        n = nval - 1
        M = xp.shape[0]
        x0v = x[0]
        xLv = x[nmax - 1]
        # i0_clip_max = nmax - n - 1
        clip_max = nmax - n - 1
        for m in prange(M):
            xpm = xp[m]
            # C: error if outside [x[0], x[nmax-1]]
            if xpm < x0v or xpm > xLv:
                # Match numpy raise: produce NaN; parity-test would catch it.
                yp_out[m] = np.nan
                continue
            # C: find first i with x[i] >= xpm  (searchsorted, side='left')
            # Linear search is O(nmax) but nmax<=64 in gmtsar orbit context;
            # binary search to be safe.
            lo = 0
            hi = nmax
            while lo < hi:
                mid = (lo + hi) >> 1
                if x[mid] < xpm:
                    lo = mid + 1
                else:
                    hi = mid
            i = lo
            i0 = i - (n + 1) // 2
            if i0 < 0:
                i0 = 0
            elif i0 > clip_max:
                i0 = clip_max
            yp = 0.0
            for ii in range(nval):
                xi = x[i0 + ii]
                hj = 1.0
                sj = 0.0
                for jj in range(nval):
                    if jj == ii:
                        continue
                    xj = x[i0 + jj]
                    # C: hj = hj * (xpm - xj) / (xi - xj)
                    # Mira #5: left-associative ((hj*(xpm-xj))/(xi-xj))
                    hj = (hj * (xpm - xj)) / (xi - xj)
                    sj = sj + 1.0 / (xi - xj)
                f0 = 1.0 - 2.0 * (xpm - xi) * sj
                f1 = xpm - xi
                # C: yp = yp + (y*f0 + z*f1) * hj * hj   (left-assoc)
                yp = yp + (y[i0 + ii] * f0 + z[i0 + ii] * f1) * hj * hj
            yp_out[m] = yp


def hermite_c_1d_numba(x: np.ndarray, y: np.ndarray, z: np.ndarray,
                       xp: np.ndarray, nval: int = 6) -> np.ndarray:
    """Numba-accelerated bit-faithful wrapper around _hermite_c_1d_jit.

    Same contract as `hermite_c_1d` (the pure-numpy reference). Falls back
    to the numpy implementation when numba isn't installed / disabled.
    """
    if not _HAS_NUMBA:
        return hermite_c_1d(x, y, z, xp, nval)
    x = np.ascontiguousarray(x, dtype=np.float64)
    y = np.ascontiguousarray(y, dtype=np.float64)
    z = np.ascontiguousarray(z, dtype=np.float64)
    xp = np.ascontiguousarray(np.atleast_1d(xp), dtype=np.float64)
    out = np.empty(xp.shape[0], dtype=np.float64)
    _hermite_c_1d_jit(x, y, z, xp, int(nval), out)
    return out


def hermite_orbit(times: np.ndarray, orbit: np.ndarray, t_query: np.ndarray
                  ) -> np.ndarray:
    """Interpolate orbit (x, y, z) at query times via Hermite interpolation.

    orbit shape: (N, 7) — t, px, py, pz, vx, vy, vz.
    Returns (M, 3) array of (px, py, pz) at each t_query.

    Auto-detects uniform-grid orbit (gmtsar's always uniform) and uses
    the precomputed-basis fast path; falls back to general hermite_c_1d
    otherwise. The earlier scipy.CubicHermiteSpline (2-point local) gave
    ~mm orbit-position diffs vs C's 6-point Hermite → ~pixel azi_pix
    divergence downstream. This matches C exactly while being faster.
    """
    t_query = np.atleast_1d(t_query)
    out = np.empty((t_query.size, 3))
    # Uniform-grid fast path (typical gmtsar orbit format).
    t_orb = orbit[:, 0]
    dsec = t_orb[1] - t_orb[0]
    is_uniform = (orbit.shape[0] >= 2 and
                  np.allclose(np.diff(t_orb), dsec, rtol=1e-12, atol=1e-12))
    if is_uniform:
        x0 = float(t_orb[0])
        _herm_u = hermite_c_1d_uniform_numba if _HAS_NUMBA else hermite_c_1d_uniform
        out[:, 0] = _herm_u(x0, dsec, orbit[:, 1], orbit[:, 4], t_query)
        out[:, 1] = _herm_u(x0, dsec, orbit[:, 2], orbit[:, 5], t_query)
        out[:, 2] = _herm_u(x0, dsec, orbit[:, 3], orbit[:, 6], t_query)
    else:
        _herm_g = hermite_c_1d_numba if _HAS_NUMBA else hermite_c_1d
        out[:, 0] = _herm_g(orbit[:, 0], orbit[:, 1], orbit[:, 4], t_query)
        out[:, 1] = _herm_g(orbit[:, 0], orbit[:, 2], orbit[:, 5], t_query)
        out[:, 2] = _herm_g(orbit[:, 0], orbit[:, 3], orbit[:, 6], t_query)
    return out


# ---------------------------------------------------------- C4 pre-sample ---
def presample_orbit(orbit: np.ndarray, t1: float, t2: float,
                    ts: float, npad: int = 8000,
                    meta: dict | None = None) -> np.ndarray:
    """Sample the orbit at uniform `ts`-spaced times over [t1-npad*ts,
    t2+npad*ts]. The padding lets goldop find closest-approach points
    outside the strict acquisition window (which can be 10+ s of
    real-world time depending on viewing geometry). Mirrors C calorb_alos
    which uses npad=8000 (~12s with default ts=2/PRF).

    Returns (nrec_total, 4): [t, px, py, pz].

    C-faithful, fix #1: mirrors `nrec = (int)((t2-t1)/ts)` and
    `time = t1 - npad*ts + i*ts` (per-index, NOT np.arange which
    accumulates a ~1e-5 s drift over 18k samples → ~7 mpx azi_pix bias).

    C-faithful, fix #2: when `meta` is provided (with id, sec, dsec),
    interpolate using C-style synthetic orbit time-knots
    `pt[k] = 86400*id + sec + k*dsec` — NOT the actual LED times
    parsed from the ASCII (which have ~1e-9 s roundoff that propagates
    to ~1e-5 m orbit position error → flipped goldop branches on ~20
    edge-case targets near the rng-vs-tm minimum). This matches C
    calorb_alos lines 429-432 bit-exactly.
    """
    nrec = int((t2 - t1) / ts)
    n_total = nrec + 2 * npad
    i = np.arange(n_total, dtype=np.int64)
    # Per-index formula matches C calorb_alos line 444: time = t1 - npad*ts + i*ts
    times = t1 - npad * ts + i * ts

    if meta is not None and "id" in meta and "sec" in meta and "dsec" in meta:
        # C-style synthetic time knots (matches C lines 429-432 bit-exactly).
        # Use the GENERAL hermite_c_1d (line-by-line port of C hermite_c.c),
        # NOT the Horner-basis fast path — the latter is algebraically
        # equivalent but ~1e-6 m off from C due to different roundoff
        # accumulation in polynomial evaluation. General path + synthetic
        # knots gives BIT-EXACT match to C `hermite_c` on the RS2 dataset.
        pt0 = 86400.0 * meta["id"] + meta["sec"]
        dsec = float(meta["dsec"])
        synth_times = pt0 + np.arange(orbit.shape[0], dtype=np.float64) * dsec
        # Numba-accelerated when available; falls back to pure-numpy.
        _herm = hermite_c_1d_numba if _HAS_NUMBA else hermite_c_1d
        x_out = _herm(synth_times, orbit[:, 1], orbit[:, 4], times)
        y_out = _herm(synth_times, orbit[:, 2], orbit[:, 5], times)
        z_out = _herm(synth_times, orbit[:, 3], orbit[:, 6], times)
        pxyz = np.column_stack([x_out, y_out, z_out])
    else:
        # Fallback for callers that don't pass meta (preserved for back-compat).
        pxyz = hermite_orbit(orbit[:, 0:7], orbit, times)
    return np.column_stack([times, pxyz])


# ---------------------------------------------------------- C5 goldop ---
def _range_at(orb_pos: np.ndarray, i: int, xp: float, yp: float, zp: float
              ) -> float:
    """Range from orbit sample i to target (xp, yp, zp)."""
    dx = xp - orb_pos[i, 1]
    dy = yp - orb_pos[i, 2]
    dz = zp - orb_pos[i, 3]
    return np.sqrt(dx * dx + dy * dy + dz * dz)


def goldop(orb_pos: np.ndarray, xp: float, yp: float, zp: float,
           stai: int = 0, endi: int | None = None,
           tol: float = 1.0) -> tuple[float, float]:
    """C-faithful scalar golden-section search for time-of-closest-approach.

    Mirrors SAT_llt2rat.c lines 332-393 line by line:
      - x0..x3 = 4-point bracket (int indices)
      - SHFT3/SHFT2 macros: cascade assignments with cross-dependencies
        (the NEW x2 in the f2<f1 branch uses OLD x2, NOT OLD x1, because
        the macro `(a)=(b); (b)=(c); (c)=(d)` evaluates `d` textually
        AFTER x1 has been overwritten with x2_old)
      - Uses C's truncated constants R=0.61803399, C=0.382 (NOT exact
        golden ratio) — see module-level constants
      - While loop terminates on (x3-x0) <= 2 or x2 == x1

    Used by unit tests; the driver uses `goldop_batch` for the live workload.
    """
    if endi is None:
        endi = orb_pos.shape[0] - 1
    ax, bx = stai, endi
    # C: midi = (stai + (endi - stai) * C_GOLD)  — int truncation
    cx = int(ax + (bx - ax) * C_GOLD)

    x0 = ax
    x3 = bx
    if abs(bx - cx) > abs(cx - ax):
        x1 = cx
        x2 = cx + int(abs(C_GOLD * (bx - cx)))
    else:
        x2 = cx
        x1 = cx - int(abs(C_GOLD * (cx - ax)))

    f1 = _range_at(orb_pos, x1, xp, yp, zp)
    f2 = _range_at(orb_pos, x2, xp, yp, zp)

    while (x3 - x0) > 2 and (x2 != x1):
        if f2 < f1:
            # SHFT3(x0, x1, x2, (int)(R*x3 + C*x1));
            # Cascade: x0:=x1; x1:=x2; x2:=int(R*x3 + C*x1_AFTER) which
            # is x2_OLD because x1 was just overwritten with x2_old.
            new_x0 = x1
            new_x1 = x2
            new_x2 = int(R_GOLD_C * x3 + C_GOLD * x2)  # OLD x2
            x0, x1, x2 = new_x0, new_x1, new_x2
            # SHFT2(f1, f2, dist(...,x2_new,...))
            f1 = f2
            f2 = _range_at(orb_pos, x2, xp, yp, zp)
        else:
            # SHFT3(x3, x2, x1, (int)(R*x0 + C*x2));
            # x3:=x2; x2:=x1; x1:=int(R*x0 + C*x2_AFTER) = int(R*x0 + C*x1_OLD)
            new_x3 = x2
            new_x2 = x1
            new_x1 = int(R_GOLD_C * x0 + C_GOLD * x1)  # OLD x1
            x3, x2, x1 = new_x3, new_x2, new_x1
            # SHFT2(f2, f1, dist(...,x1_new,...))
            f2 = f1
            f1 = _range_at(orb_pos, x1, xp, yp, zp)

    if f1 < f2:
        tm = float(orb_pos[x1, 0])
        rng = f1
    else:
        tm = float(orb_pos[x2, 0])
        rng = f2
    return rng, tm


# ---------- Numba JIT kernel for goldop_batch --------------------------------
# Line-by-line scalar mirror of C `goldop` in SAT_llt2rat.c (lines 332-393),
# applied per-target. This is actually CLEANER for parity than the np.where
# vectorisation above because it mirrors the scalar C function 1:1 — same
# SHFT3/SHFT2 cascade with OLD-value capture, same int truncation via Numba
# float64-to-int64 cast, same per-iter sqrt (Mira bug #9).
#
# Constants captured: R_GOLD_C=0.61803399, C_GOLD=0.382 (Mira bug "truncated
# golden ratio in C #define R, C"). We hard-bake these inside the kernel
# (Numba constants) so they propagate as literals, NOT module-level lookups.
if _HAS_NUMBA:
    # parallel=True + prange over the per-target outer loop. Each target
    # runs its own scalar goldop iterating x0/x1/x2/x3/f1/f2 to convergence
    # — no cross-target FP reductions, only disjoint writes to R_out[n] and
    # T_out[n]. Bit-parity with the single-thread scalar mirror is preserved.
    @njit(cache=False, fastmath=False, parallel=True)
    def _goldop_jit(op_t, px, py, pz, tx, ty, tz, R_out, T_out):
        R_LIT = 0.61803399
        C_LIT = 0.382
        nrec = px.shape[0]
        N = tx.shape[0]
        ax_init = 0
        bx_init = nrec - 1
        cx_init = int(ax_init + (bx_init - ax_init) * C_LIT)
        # Per-target initial bracket (all identical at start). Per-C:
        #   if abs(bx-cx) > abs(cx-ax): x1=cx, x2=cx+int(abs(C*(bx-cx)))
        #   else:                       x2=cx, x1=cx-int(abs(C*(cx-ax)))
        if abs(bx_init - cx_init) > abs(cx_init - ax_init):
            x1_init = cx_init
            x2_init = cx_init + int(abs(C_LIT * (bx_init - cx_init)))
        else:
            x2_init = cx_init
            x1_init = cx_init - int(abs(C_LIT * (cx_init - ax_init)))
        for n in prange(N):
            ttx = tx[n]
            tty = ty[n]
            ttz = tz[n]
            x0 = 0
            x3 = bx_init
            x1 = x1_init
            x2 = x2_init
            # f1 = dist(orb_pos[x1], target)
            dx1 = ttx - px[x1]
            dy1 = tty - py[x1]
            dz1 = ttz - pz[x1]
            f1 = np.sqrt(dx1 * dx1 + dy1 * dy1 + dz1 * dz1)
            dx2 = ttx - px[x2]
            dy2 = tty - py[x2]
            dz2 = ttz - pz[x2]
            f2 = np.sqrt(dx2 * dx2 + dy2 * dy2 + dz2 * dz2)
            # while (x3 - x0) > 2 and x2 != x1
            for _it in range(64):
                if not ((x3 - x0) > 2 and x2 != x1):
                    break
                if f2 < f1:
                    # SHFT3(x0,x1,x2,(int)(R*x3 + C*x1));
                    # cascade reads x1 AFTER assignment to x2_old → uses x2_old
                    new_x0 = x1
                    new_x1 = x2
                    new_x2 = int(R_LIT * x3 + C_LIT * x2)  # OLD x2
                    x0 = new_x0
                    x1 = new_x1
                    x2 = new_x2
                    # clip to valid range (defensive; matches numpy version)
                    if x2 < 0:
                        x2 = 0
                    elif x2 > nrec - 1:
                        x2 = nrec - 1
                    # SHFT2(f1,f2,dist(...,x2_new,...))
                    f1 = f2
                    dxn = ttx - px[x2]
                    dyn = tty - py[x2]
                    dzn = ttz - pz[x2]
                    f2 = np.sqrt(dxn * dxn + dyn * dyn + dzn * dzn)
                else:
                    # SHFT3(x3,x2,x1,(int)(R*x0 + C*x2));
                    # cascade reads x2 AFTER overwrite to x1_old → uses x1_old
                    new_x3 = x2
                    new_x2 = x1
                    new_x1 = int(R_LIT * x0 + C_LIT * x1)  # OLD x1
                    x3 = new_x3
                    x2 = new_x2
                    x1 = new_x1
                    if x1 < 0:
                        x1 = 0
                    elif x1 > nrec - 1:
                        x1 = nrec - 1
                    # SHFT2(f2,f1,dist(...,x1_new,...))
                    f2 = f1
                    dxn = ttx - px[x1]
                    dyn = tty - py[x1]
                    dzn = ttz - pz[x1]
                    f1 = np.sqrt(dxn * dxn + dyn * dyn + dzn * dzn)
            # Winner (C lines 371-390)
            if f1 < f2:
                chosen = x1
                rng = f1
            else:
                chosen = x2
                rng = f2
            if chosen < 0:
                chosen = 0
            elif chosen > nrec - 1:
                chosen = nrec - 1
            R_out[n] = rng
            T_out[n] = op_t[chosen]


def goldop_batch(orb_pos: np.ndarray, targets: np.ndarray,
                 chunk: int = 200_000
                 ) -> tuple[np.ndarray, np.ndarray]:
    """C-faithful vectorised true-4-point golden-section search.

    Mirrors SAT_llt2rat.c `goldop` line-by-line, lock-step over N targets.
    Each target carries its own (x0, x1, x2, x3, f1, f2) state and selects
    which SHFT3/SHFT2 branch to take per iteration via np.where. The loop
    continues until ALL targets have converged (per-target convergence
    mask gates further updates).

    Vectorisation trap (Pattern 4): the C SHFT3 macro has cross-dependent
    cascading assignments. In the `f2<f1` branch:
        x0 := x1_OLD
        x1 := x2_OLD
        x2 := int(R*x3_OLD + C*x2_OLD)   ← uses OLD x2, not OLD x1
    Because the macro `(a)=(b); (b)=(c); (c)=(d)` evaluates `d` textually
    AFTER x1 has been overwritten with x2_old.

    We capture ALL old values into locals first, then commit all new
    values via np.where, gated by the not-yet-converged mask.

    orb_pos: (nrec, 4) — [t, px, py, pz]
    targets: (N, 3)    — ECEF (xp, yp, zp) per target
    Returns (ranges, times) — minimum range + orbit time per target.
    """
    op_t = np.ascontiguousarray(orb_pos[:, 0])
    px = np.ascontiguousarray(orb_pos[:, 1])
    py = np.ascontiguousarray(orb_pos[:, 2])
    pz = np.ascontiguousarray(orb_pos[:, 3])
    nrec = px.shape[0]

    tx = np.ascontiguousarray(targets[:, 0])
    ty = np.ascontiguousarray(targets[:, 1])
    tz = np.ascontiguousarray(targets[:, 2])
    N = tx.shape[0]

    R_out = np.empty(N, dtype=np.float64)
    T_out = np.empty(N, dtype=np.float64)

    # ---- Numba JIT fast path (single-thread, fastmath=False, scalar-per-target).
    # The scalar Numba kernel mirrors C `goldop` line-by-line (cleaner parity
    # than the np.where vectorisation below; same SHFT3/SHFT2 cascade with
    # OLD-value capture, same per-iter sqrt, same int truncation).
    if _HAS_NUMBA:
        _goldop_jit(op_t, px, py, pz, tx, ty, tz, R_out, T_out)
        return R_out, T_out

    # Bracket initialisation (C main(): stai=0, endi=nrec-1, midi=int(stai+(endi-stai)*C))
    ax_init = 0
    bx_init = nrec - 1
    cx_init = int(ax_init + (bx_init - ax_init) * C_GOLD)

    def _dist2(idx, ttx, tty, ttz):
        dx = ttx - px[idx]
        dy = tty - py[idx]
        dz = ttz - pz[idx]
        return dx * dx + dy * dy + dz * dz

    for s in range(0, N, chunk):
        e = min(s + chunk, N)
        m = e - s
        ttx = tx[s:e]
        tty = ty[s:e]
        ttz = tz[s:e]

        # Per-target initial bracket (all identical at start).
        x0 = np.full(m, ax_init, dtype=np.int64)
        x3 = np.full(m, bx_init, dtype=np.int64)
        # Per-C: if abs(bx-cx) > abs(cx-ax): x1=cx, x2=cx+int(abs(C*(bx-cx)))
        #        else: x2=cx, x1=cx-int(abs(C*(cx-ax)))
        if abs(bx_init - cx_init) > abs(cx_init - ax_init):
            x1_v = cx_init
            x2_v = cx_init + int(abs(C_GOLD * (bx_init - cx_init)))
        else:
            x2_v = cx_init
            x1_v = cx_init - int(abs(C_GOLD * (cx_init - ax_init)))
        x1 = np.full(m, x1_v, dtype=np.int64)
        x2 = np.full(m, x2_v, dtype=np.int64)

        # We MUST take sqrt to match C's compare semantics: sqrt is
        # mathematically monotonic but at the FLOATING-POINT ULP level
        # tiny f²-differences can be wiped out by sqrt rounding to the
        # SAME float, so f²<f² can return True while sqrt(f²)<sqrt(f²)
        # returns False (or vice-versa). Skipping the sqrt produces
        # different branch decisions on ~20 edge-case targets where
        # f1 ≈ f2 at convergence. C uses sqrt — we must too.
        def _dist(idx, ttx, tty, ttz):
            return np.sqrt(_dist2(idx, ttx, tty, ttz))
        f1 = _dist(x1, ttx, tty, ttz)
        f2 = _dist(x2, ttx, tty, ttz)

        # Active mask: True while (x3 - x0) > 2 AND (x2 != x1)
        # When a target converges, freeze it.
        max_iter = 64  # log_phi(nrec) ≈ 21; bail-out safety
        for _it in range(max_iter):
            active = ((x3 - x0) > 2) & (x2 != x1)
            if not active.any():
                break

            # Branch mask: f2 < f1  (only meaningful where active)
            left_branch = f2 < f1

            # --- Capture OLD values BEFORE any updates ---
            x0_old = x0
            x1_old = x1
            x2_old = x2
            x3_old = x3
            f1_old = f1
            f2_old = f2

            # --- Branch A: f2 < f1 ---
            # SHFT3(x0,x1,x2, (int)(R*x3 + C*x1));
            # → x0:=x1_old; x1:=x2_old; x2:=int(R*x3_old + C*x2_old)
            #   (the "C*x1" in the SHFT3 d-expr is evaluated AFTER x1 was
            #    overwritten with x2_old, so it reads x2_old)
            x0_A = x1_old
            x1_A = x2_old
            x2_A = (R_GOLD_C * x3_old + C_GOLD * x2_old).astype(np.int64)
            x3_A = x3_old
            # SHFT2(f1, f2, dist(x2_new)) → f1:=f2_old; f2:=dist(x2_A)
            x2_A_safe = np.clip(x2_A, 0, nrec - 1)
            f2_A = _dist(x2_A_safe, ttx, tty, ttz)
            f1_A = f2_old

            # --- Branch B: f2 >= f1 (else) ---
            # SHFT3(x3,x2,x1, (int)(R*x0 + C*x2));
            # → x3:=x2_old; x2:=x1_old; x1:=int(R*x0_old + C*x1_old)
            #   ("C*x2" in d-expr reads x2 AFTER overwrite to x1_old → x1_old)
            x3_B = x2_old
            x2_B = x1_old
            x1_B = (R_GOLD_C * x0_old + C_GOLD * x1_old).astype(np.int64)
            x0_B = x0_old
            # SHFT2(f2, f1, dist(x1_new)) → f2:=f1_old; f1:=dist(x1_B)
            x1_B_safe = np.clip(x1_B, 0, nrec - 1)
            f1_B = _dist(x1_B_safe, ttx, tty, ttz)
            f2_B = f1_old

            # --- Commit: where active, pick branch A or B; else keep old ---
            update = active
            take_A = update & left_branch
            take_B = update & ~left_branch

            x0 = np.where(take_A, x0_A, np.where(take_B, x0_B, x0_old))
            x1 = np.where(take_A, x1_A, np.where(take_B, x1_B, x1_old))
            x2 = np.where(take_A, x2_A, np.where(take_B, x2_B, x2_old))
            x3 = np.where(take_A, x3_A, np.where(take_B, x3_B, x3_old))
            f1 = np.where(take_A, f1_A, np.where(take_B, f1_B, f1_old))
            f2 = np.where(take_A, f2_A, np.where(take_B, f2_B, f2_old))

        # --- Pick winner (mirror C lines 371-390) ---
        # if (f1 < f2): xmin = x1; tm = orb_pos[x1]; rng = f1
        # else:         xmin = x2; tm = orb_pos[x2]; rng = f2
        pick_x1 = f1 < f2
        chosen = np.where(pick_x1, x1, x2)
        # Defensive clip — should be no-op for valid runs but guards against
        # the C bug where x1/x2 can briefly leave [ax,bx] during the search.
        chosen_safe = np.clip(chosen, 0, nrec - 1)
        R_out[s:e] = np.where(pick_x1, f1, f2)
        T_out[s:e] = op_t[chosen_safe]
    return R_out, T_out


# ---------------------------------------------------------- C6 polyfit refine ---
def polyfit_c(T: np.ndarray, Y: np.ndarray, N: int) -> np.ndarray:
    """Bit-faithful port of gmtsar's polyfit.c + gauss_jordan.c.

    Fits the lowest-N-order polynomial via NORMAL EQUATIONS:
        A[i,j] = sum_k T[k]^(i+j)         (Hankel matrix)
        B[j]   = sum_k Y[k] * T[k]^j
        Solve A @ C = B by gauss-jordan elimination + back-substitution.

    Returns C of length N: [c0, c1, ..., c_{N-1}] such that
        Y ≈ c0 + c1*T + c2*T^2 + ... + c_{N-1}*T^{N-1}

    Differs from numpy.polyfit (Vandermonde + LAPACK lstsq) at the
    ~1e-15 level for well-conditioned problems — but the C code uses
    THIS exact routine in SAT_llt2rat.c precise=1, so we mirror it
    bit-for-bit to match downstream tm/rng0 values.
    """
    T = np.asarray(T, dtype=np.float64)
    Y = np.asarray(Y, dtype=np.float64)
    M = T.size
    if N > M:
        raise ValueError("polyfit_c: underdetermined system (N > M)")

    A = np.zeros((N, N), dtype=np.float64)
    B = np.zeros(N, dtype=np.float64)

    # B[j] = sum_k Y[k] * T[k]^j   (j in 0..N-1)
    pow_T = np.ones_like(T)               # T^0
    for j in range(N):
        B[j] = (Y * pow_T).sum()
        pow_T *= T

    # A[i,j] = sum_k T[k]^(i+j)   (i,j in 0..N-1) — Hankel
    # The C loop computes pow_T = T^(j+i) at each (i,j), redundant but
    # bit-faithful. Vectorized: build all needed powers once.
    # We need T^p for p in 0..2*(N-1)
    powers = np.empty((2 * N - 1, M), dtype=np.float64)
    powers[0] = 1.0
    for p in range(1, 2 * N - 1):
        powers[p] = powers[p - 1] * T
    sum_powers = powers.sum(axis=1)        # (2N-1,)
    for i in range(N):
        for j in range(N):
            A[i, j] = sum_powers[i + j]

    # gauss_jordan elimination + back-substitution (C: gauss_jordan in
    # polyfit.c). C iterates m = k each outer step (no partial pivoting),
    # only eliminates downward, then swaps row k with row m via the j-loop.
    # m=k means swap is identity, so net effect: forward elimination only.
    # Replicate C exactly to avoid numerical drift.
    A = A.copy()
    B = B.copy()
    for k in range(N):
        m = k
        for l in range(m + 1, N):
            if A[k, m] != 0.0:
                factor = A[k, l] / A[k, m]
                # row operation on A: A[j, l] -= factor * A[j, m] for all j
                A[:, l] -= factor * A[:, m]
                B[l] -= factor * B[m]
        # row swap of row k with row m (m == k → no-op, but bit-faithful)
        if m != k:
            A[:, [k, m]] = A[:, [m, k]]
            B[k], B[m] = B[m], B[k]
    # back-substitute
    X = np.zeros(N, dtype=np.float64)
    N0 = N - 1
    X[N0] = B[N0] / A[N0, N0]
    for p in range(N):
        u_lo = N0 - p + 1
        sum_ = (A[u_lo:N, N0 - p] * X[u_lo:N]).sum() if u_lo < N else 0.0
        X[N0 - p] = (B[N0 - p] - sum_) / A[N0 - p, N0 - p]
    return X


def polyfit_refine_batch(orbit: np.ndarray, tm_arr: np.ndarray,
                         xyz: np.ndarray, lookdir: int,
                         ntt: int = 10
                         ) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Vectorized 2nd-order polynomial refinement of (rng0, tm) + curl/det
    sign. Mirrors the precise=1 path in SAT_llt2rat.c exactly.

    Args:
        orbit:   (N, 7) raw orbit nodes [t, px, py, pz, vx, vy, vz]
        tm_arr:  (M,)   initial closest-approach times from goldop
        xyz:     (M, 3) ECEF target positions
        lookdir: +1 right-looking, -1 left-looking

    Returns: (rng0_refined, tm_refined, det) — each (M,). `det` is ±1.0;
    the caller should apply `xt[0] = rng0 * det` to get signed range.
    """
    M = tm_arr.size
    dt = 1.0 / ntt
    time_off = dt * (np.arange(ntt) - ntt / 2 + 0.5)   # (ntt,)

    # Evaluate orbit at all (M * ntt) sample times in one batched call.
    abs_times = (tm_arr[:, None] + time_off[None, :]).reshape(-1)   # (M*ntt,)
    p_all = hermite_orbit(orbit[:, 0:7], orbit, abs_times)            # (M*ntt, 3)
    p_all = p_all.reshape(M, ntt, 3)

    # Range[k] for each target: |xyz - p_all[k]| - rng0 ... but C computes
    # rng[k] = sqrt(...) - rng0 where rng0 is the goldop value. Since the
    # polyfit only uses rng[k] up to a constant shift (vertex location is
    # invariant under +const), we can fit on the unshifted range.
    diff = xyz[:, None, :] - p_all              # (M, ntt, 3)
    rng_samples = np.sqrt((diff * diff).sum(axis=2))   # (M, ntt)

    # Fit ax^2 + bx + c per target. Vertex at x = -b/(2a).
    # Use C-faithful polyfit per target (same algo as polyfit.c).
    # Vectorized normal equations: for 2nd order (N=3), A is (3,3) Hankel,
    # SAME for every target since time_off is identical. Only B varies.
    N = 3
    powers_t = np.empty((2 * N - 1, ntt), dtype=np.float64)
    powers_t[0] = 1.0
    for p in range(1, 2 * N - 1):
        powers_t[p] = powers_t[p - 1] * time_off
    sum_powers_t = powers_t.sum(axis=1)         # (2N-1,)
    A_const = np.empty((N, N), dtype=np.float64)
    for i in range(N):
        for j in range(N):
            A_const[i, j] = sum_powers_t[i + j]

    # B[m, j] = sum_k rng_samples[m, k] * time_off[k]^j  for each target m
    Bmat = np.empty((M, N), dtype=np.float64)
    pow_T = np.ones_like(time_off)
    for j in range(N):
        Bmat[:, j] = (rng_samples * pow_T).sum(axis=1)
        pow_T *= time_off

    # Apply gauss_jordan elimination to A (constant) and to each row of Bmat.
    A = A_const.copy()
    B = Bmat.copy()                             # (M, N)
    for k in range(N):
        for l in range(k + 1, N):
            if A[k, k] != 0.0:
                factor = A[k, l] / A[k, k]
                A[:, l] -= factor * A[:, k]
                B[:, l] -= factor * B[:, k]
    # back-substitute per target. After elimination A is upper-tri in cols.
    X = np.zeros((M, N), dtype=np.float64)
    N0 = N - 1
    X[:, N0] = B[:, N0] / A[N0, N0]
    for p in range(1, N):
        idx_back = N0 - p
        sum_ = (A[idx_back + 1:N, idx_back][None, :] * X[:, idx_back + 1:N]
                ).sum(axis=1)
        X[:, idx_back] = (B[:, idx_back] - sum_) / A[idx_back, idx_back]

    # X = [d0, d1, d2] per target. Vertex dtt = -d1 / (2*d2).
    d1 = X[:, 1]; d2 = X[:, 2]
    safe = np.abs(d2) > 1e-30
    dtt = np.where(safe, -d1 / (2.0 * np.where(safe, d2, 1.0)), 0.0)
    tm_refined = tm_arr + dtt

    # Re-evaluate orbit at refined tm
    p_ref = hermite_orbit(orbit[:, 0:7], orbit, tm_refined)   # (M, 3)
    diff_ref = xyz - p_ref
    rng_ref = np.sqrt((diff_ref * diff_ref).sum(axis=1))

    # Curl / det sign (per C lines 250-270):
    #   vec0 = orbit at k=0; vec1 = orbit at k=ntt-1; vec1 -= vec0  (~track dir)
    #   vec2 = xyz - orbit at refined tm
    #   det  = (cross(vec2, vec1)) · (xs, ys, zs at refined tm)
    #   sign = +1 if det*lookdir > 0 else -1
    vec0 = p_all[:, 0, :]                       # (M, 3)
    vec1 = p_all[:, ntt - 1, :] - vec0          # (M, 3) — track direction
    vec2 = diff_ref                              # (M, 3)
    cross = np.empty_like(vec2)
    cross[:, 0] = vec2[:, 1] * vec1[:, 2] - vec2[:, 2] * vec1[:, 1]
    cross[:, 1] = vec2[:, 2] * vec1[:, 0] - vec2[:, 0] * vec1[:, 2]
    cross[:, 2] = vec2[:, 0] * vec1[:, 1] - vec2[:, 1] * vec1[:, 0]
    det_val = (cross * p_ref).sum(axis=1)
    det = np.where(det_val * lookdir > 0, 1.0, -1.0)

    return rng_ref, tm_refined, det


def polyfit_refine(orbit: np.ndarray, tm: float, xp: float, yp: float,
                   zp: float, ntt: int = 10) -> tuple[float, float]:
    """Scalar wrapper around polyfit_refine_batch (kept for tests)."""
    r, t, _det = polyfit_refine_batch(
        orbit,
        np.array([tm]),
        np.array([[xp, yp, zp]]),
        lookdir=1,
        ntt=ntt,
    )
    return float(r[0]), float(t[0])


# ---------------------------------------------------------- C7 pixel coords ---
def to_pixel_coords(rng0: float, tm: float, prm: dict,
                    dr: float, t1: float) -> tuple[float, float]:
    """Convert (range, time) to (range_pixel, azimuth_pixel) using PRM."""
    range_pix = (rng0 - _prm_f(prm, "near_range")) / dr \
        - (_prm_f(prm, "rshift") + _prm_f(prm, "sub_int_r")) \
        + _prm_f(prm, "chirp_ext")
    azi_pix = _prm_f(prm, "PRF") * (tm - t1) \
        - (_prm_f(prm, "ashift") + _prm_f(prm, "sub_int_a"))
    return range_pix, azi_pix


def doppler_correct(range_pix: float, azi_pix: float, rng0: float,
                    prm: dict, dr: float) -> tuple[float, float]:
    """Optional Doppler correction (applied when fd1 != 0)."""
    fd1 = _prm_f(prm, "fd1")
    if fd1 == 0.0:
        return range_pix, azi_pix
    fdd1 = _prm_f(prm, "fdd1")
    near_range = _prm_f(prm, "near_range")
    num_rng_bins = _prm_i(prm, "num_rng_bins")
    vel = _prm_f(prm, "SC_vel") or _prm_f(prm, "vel")
    lambda_ = _prm_f(prm, "radar_wavelength") or _prm_f(prm, "lambda")
    prf = _prm_f(prm, "PRF")
    dopc = fd1 + fdd1 * (near_range + dr * num_rng_bins / 2.0)
    rdd = vel * vel / rng0
    daa = -0.5 * (lambda_ * dopc) / rdd
    drr = 0.5 * rdd * daa * daa / dr
    daa = prf * daa
    return range_pix + drr, azi_pix + daa


# ---------------------------------------------------------- C8 CLI + driver ---
def main() -> int:
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("prm")
    p.add_argument("precise", type=int)
    p.add_argument("-bos", action="store_true",
                   help="single-precision 5-float binary stdout")
    p.add_argument("-bod", action="store_true",
                   help="double-precision 5-double binary stdout")
    p.add_argument("-bi3d", action="store_true",
                   help="binary stdin, 3 doubles per row (xyz). Pair "
                        "with `gmt grd2xyz -bo3d` upstream — that alone "
                        "drops the upstream stage from 16 s → 0.87 s on "
                        "the RS2 DEM and makes this binary the fastest "
                        "path overall.")
    ns = p.parse_args()
    otype = 1
    if ns.bos:
        otype = 2
    elif ns.bod:
        otype = 3

    prm = read_prm(ns.prm)
    led_path = _prm_s(prm, "led_file")
    if not led_path:
        # PRM may have "led_file = X.LED" without "= " — try fallback parse
        led_path = prm.get("led_file", "").split()[0]
    if not os.path.isabs(led_path):
        led_path = os.path.join(os.path.dirname(ns.prm), led_path)
    meta, orbit = read_led(led_path)

    # Constants — PRM key names differ from the C struct field names that
    # SAT_llt2rat.c uses internally. Mapping:
    #   C prm.fs      ↔ PRM rng_samp_rate
    #   C prm.ra      ↔ PRM equatorial_radius
    #   C prm.rc      ↔ PRM polar_radius
    #   C prm.RE      ↔ PRM earth_radius
    #   C prm.vel     ↔ PRM SC_vel
    #   C prm.lambda  ↔ PRM radar_wavelength
    fs = _prm_f(prm, "rng_samp_rate") or _prm_f(prm, "fs")
    dr = 0.5 * SOL / fs
    ra = _prm_f(prm, "equatorial_radius") or _prm_f(prm, "ra") or 6378137.0
    rc = _prm_f(prm, "polar_radius") or _prm_f(prm, "rc") or 6356752.31
    re_radius = (_prm_f(prm, "earth_radius") or _prm_f(prm, "RE")
                 or 6371000.0)
    flattening = (ra - rc) / ra if ra > 0 else 0.0

    nrows = _prm_i(prm, "nrows")
    num_valid_az = _prm_i(prm, "num_valid_az")
    num_patches = _prm_i(prm, "num_patches")
    prf = _prm_f(prm, "PRF")
    clock_start = _prm_f(prm, "clock_start")

    # t1 / t2 in "seconds since start of year" — same convention as the
    # orbit times after read_led's day-of-year fold-in. Matches C exactly.
    t1 = 86400.0 * clock_start + (nrows - num_valid_az) / (2.0 * prf)
    t2 = t1 + num_patches * num_valid_az / prf
    ts = 2.0 / prf if prf >= 600.0 else 1.0 / prf

    # Pre-sample orbit at ts-spaced times. orb_pos[:, 0] is absolute time.
    # Pass meta so presample_orbit uses C-style synthetic time-knots
    # (pt[k] = 86400*id + sec + k*dsec) instead of the ASCII-roundoff
    # affected LED times — needed for exact C parity at edge-case
    # goldop targets near the rng-vs-tm minimum.
    orb_pos = presample_orbit(orbit, t1, t2, ts, meta=meta)

    # Bounds
    r0 = -10.0
    rf = _prm_i(prm, "num_rng_bins") + 10.0
    a0 = -20.0
    af = num_patches * num_valid_az + 20.0

    # Read ALL input xyz rows up front, then process vectorised.
    # Binary stdin (-bi3d) is the fast path: np.fromfile is ~zero-cost
    # vs np.loadtxt's ASCII parse, AND upstream `gmt grd2xyz -bo3d`
    # writes 18× faster than the ASCII variant. Together this turns the
    # 16 s grd2xyz | py pipeline into <2 s. Plain ASCII stdin still works
    # via np.loadtxt (~2.5 s parse on the 9.3 M-row RS2 case, vs 10 s for
    # the per-line Python parser this replaced).
    if ns.bi3d:
        raw = sys.stdin.buffer.read()
        if not raw:
            return 0
        flat = np.frombuffer(raw, dtype=np.float64)
        if flat.size % 3 != 0:
            print("SAT_llt2rat_py: -bi3d stream not a multiple of 3 doubles",
                  file=sys.stderr)
            return 2
        arr = flat.reshape(-1, 3)
    else:
        try:
            arr = np.loadtxt(sys.stdin.buffer, dtype=np.float64,
                             usecols=(0, 1, 2))
        except (ValueError, StopIteration):
            return 0
        if arr.size == 0:
            return 0
        arr = np.atleast_2d(arr)
    lon = arr[:, 0]
    lat = arr[:, 1]
    hgt = arr[:, 2]

    # plh2xyz vectorised over all targets
    xyz = plh2xyz(lat, lon, hgt, ra, flattening)   # (N, 3)
    # Local height: |xyz| - RE
    h_local = np.sqrt((xyz ** 2).sum(axis=1)) - re_radius

    # Batched goldop — one (N, nrec) range matrix, row-wise argmin.
    rng0, tm = goldop_batch(orb_pos, xyz)

    # Lookdir: +1 right, -1 left. Determines sign convention for the det
    # check in the polyfit refinement.
    lookdir_s = _prm_s(prm, "lookdir") or "R"
    lookdir = -1 if lookdir_s.upper().startswith("L") else 1

    # Optional polyfit refinement (precise=1): vectorised, includes the
    # curl/det sign check from SAT_llt2rat.c lines 234-270.
    if ns.precise == 1:
        rng0, tm, det = polyfit_refine_batch(orbit, tm, xyz,
                                              lookdir=lookdir, ntt=10)
    else:
        det = np.ones_like(rng0)

    # Apply det sign to range before pixel conversion (C line 274:
    # `xt[0] = rng0 * det`). For points on the "wrong side" of the orbit
    # for a right/left-looking SAR, this flips the sign and the bounds
    # filter below rejects them. Without this, edge cells fall into the
    # data region by mistake (the source of 8 extra rows vs C).
    rng_signed = rng0 * det

    # Vectorised pixel-coord conversion
    near_range = _prm_f(prm, "near_range")
    rshift = _prm_f(prm, "rshift")
    sub_int_r = _prm_f(prm, "sub_int_r")
    chirp_ext = _prm_f(prm, "chirp_ext")
    ashift = _prm_f(prm, "ashift")
    sub_int_a = _prm_f(prm, "sub_int_a")
    range_pix = (rng_signed - near_range) / dr - (rshift + sub_int_r) + chirp_ext
    azi_pix = prf * (tm - t1) - (ashift + sub_int_a)

    # Optional Doppler correction (mirrors C SAT_llt2rat.c lines 287-295).
    # vel + lambda_ were ONLY defined inside the unused `doppler_correct`
    # helper before — this inline path crashed with NameError on any case
    # with fd1 != 0 (ALOS_SLC_L1.1 caught it 2026-05-21). Load them here.
    fd1 = _prm_f(prm, "fd1")
    if fd1 != 0.0:
        fdd1 = _prm_f(prm, "fdd1")
        num_rng_bins = _prm_i(prm, "num_rng_bins")
        vel = _prm_f(prm, "SC_vel") or _prm_f(prm, "vel")
        lambda_ = _prm_f(prm, "radar_wavelength") or _prm_f(prm, "lambda")
        dopc = fd1 + fdd1 * (near_range + dr * num_rng_bins / 2.0)
        rdd = vel * vel / rng0
        daa = -0.5 * (lambda_ * dopc) / rdd
        drr = 0.5 * rdd * daa * daa / dr
        daa = prf * daa
        range_pix = range_pix + drr
        azi_pix = azi_pix + daa

    # Envisat correction (SC_identity == 4)
    if _prm_i(prm, "SC_identity") == 4:
        range_pix += 8.4
        azi_pix += 4.0

    # lon normalised to [-180, 180]
    lon_out = np.where(lon <= 180.0, lon, lon - 360.0)

    # Bounds filter for binary output modes
    if otype > 1:
        keep = ((range_pix >= r0) & (range_pix <= rf)
                & (azi_pix >= a0) & (azi_pix <= af))
        range_pix = range_pix[keep]
        azi_pix = azi_pix[keep]
        h_local = h_local[keep]
        lon_out = lon_out[keep]
        lat = lat[keep]

    # Write output. column_stack is ~25× faster than list(zip)+np.array
    # (0.6 s → 0.02 s on the 9.3 M-row RS2 case).
    if otype == 1:
        out_rows = list(zip(range_pix, azi_pix, h_local, lon_out, lat))
        sys.stdout.write("".join(
            "%.9f %.9f %.9f %.9f %.9f \n" % r for r in out_rows))
    elif otype == 2:
        a = np.column_stack([range_pix, azi_pix, h_local, lon_out, lat]
                            ).astype(np.float32, copy=False)
        sys.stdout.buffer.write(a.tobytes())
    elif otype == 3:
        a = np.column_stack([range_pix, azi_pix, h_local, lon_out, lat])
        sys.stdout.buffer.write(a.tobytes())
    return 0


if __name__ == "__main__":
    sys.exit(main())
