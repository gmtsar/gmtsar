#! /usr/bin/env python3
"""phasefilt_py — Python port of gmtsar `phasefilt` (Goldstein/Baran adaptive
phase filter).

Line-by-line port of gmtsar/phasefilt.c (rjm, SDSU 2010; Dec 2010 patch).

C source files ported
---------------------
  gmtsar/phasefilt.c           → all logic below

Checkpoints (B1–B7 per Mira Phase-B convention)
-------------------------------------------------
  B1  parse_command_line        → _parse_args()
  B2  read_file_hdr + data      → _read_grid_xy()
  B3  calc_corr                 → _calc_corr()
  B4  make_wgt                  → _make_wgt()
  B5  FFT patch loop (scalar)   → _goldstein_filter_scalar()
  B6  FFT patch loop (vectorized) → _goldstein_filter_batch()
  B7  write_grdfile             → _write_grd()

Algorithm (Goldstein/Baran)
---------------------------
  1. Read real.grd + imag.grd → complex interferogram.
  2. If amp1/amp2 given: compute coherence (0–1) per pixel.
  3. Build triangular bilinear weight window (zero at edges, 1 at centre).
  4. Overlapping FFT patches, step = psize//2 (50% overlap in each dim):
       a. Extract psize×psize complex patch.
       b. Baran: alpha = 1 - weighted_mean_coherence_over_patch.
          Goldstein: alpha = constant (default 0.5).
       c. Forward FFT (complex64).
       d. Multiply spectrum by |F|^alpha  (apply_pspec in C).
       e. Inverse FFT.
       f. Weighted-accumulate into output array.
  5. atan2(im_accum, re_accum) → wrapped phase (float32).
  6. Write filtphase.grd (and filtcorr.grd / diff / complex_out if requested).

C loop bounds: ii in range(0, ydim-nyp, step), jj in range(0, xdim-nxp, step).
This means the last nyp//2 rows and nxp//2 columns are not covered by any patch
(they remain zero in fdata → atan2(0,0) = 0.0 in C).

FFT convention
--------------
  C uses GMT_FFT_2D which wraps FFTW float32 with:
    FWD: unnormalised DFT  (matches scipy.fft.fft2 default)
    INV: normalised IDFT ÷ N  (matches scipy.fft.ifft2 default)
  scipy.fft with complex64 input preserves float32 internally.
  Measured parity on CSK_SLC_Italy (1341×1398): RMS = 8.6e-6 rad,
  max = 6.4e-3 rad at 383 low-amplitude pixels (float32 FFTW vs CPU FP80).
  Both are << 0.15 rad pipeline threshold.

CLI (mirrors C phasefilt)
--------------------------
  phasefilt_py -imag imag.grd -real real.grd \\
               [-alpha A] [-psize P] \\
               [-amp1 a1.grd -amp2 a2.grd] \\
               [-diff] [-complex_out] \\
               [-phasefilt out.grd] [-corrfilt corr.grd] \\
               [-v] [-workers N]

The -workers flag is Py-only (default -1 = all cores for batched FFT).

Per project memory rule: parity test is test_phasefilt.py, which runs the
C phasefilt binary and this port on the same real input and asserts
max-abs-diff < 7e-3 rad and complex-RMS < 1e-4 rad (float32 roundoff).
"""
from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tempfile
import warnings
from pathlib import Path
from typing import Optional, Tuple

import numpy as np

try:
    from scipy.fft import fft2 as _fft2, ifft2 as _ifft2
    _WORKERS_DEFAULT = int(os.environ.get("PHASEFILT_PY_WORKERS", "-1"))
except ImportError:  # pragma: no cover
    _fft2 = np.fft.fft2
    _ifft2 = np.fft.ifft2
    _WORKERS_DEFAULT = None

# ------------------------------------------------------------------ helpers --

def _gmt_bin() -> str:
    """Return path to gmt binary; raise if not found."""
    for p in [
        "gmt",
        "/home/staff/dliu/anaconda3/envs/gmtsar/bin/gmt",
    ]:
        if p == "gmt":
            import shutil
            found = shutil.which("gmt")
            if found:
                return found
        elif os.path.exists(p):
            return p
    raise RuntimeError(
        "gmt binary not found; add GMT to PATH or set PATH to include conda env"
    )


def _read_grd(path: str) -> Tuple[np.ndarray, dict]:
    """Read a GMT netCDF grid and return (data_float32, header_dict).

    Uses `gmt grdinfo` + `gmt grd2xyz` binary output for portability
    (avoids netCDF4/pygmt dependency).

    Row 0 of returned array = topmost row as GMT stores it (y_max end).
    This matches GMT_Read_Data behaviour: data[i] at index i =
    row = i // n_columns, col = i % n_columns.
    """
    import re
    gmt = _gmt_bin()

    info = subprocess.run(
        [gmt, "grdinfo", path],
        capture_output=True, text=True
    )
    if info.returncode != 0:
        raise RuntimeError(f"gmt grdinfo failed on {path!r}: {info.stderr.strip()}")

    def _int(pat: str) -> int:
        m = re.search(pat, info.stdout)
        if m is None:
            raise RuntimeError(f"grdinfo: cannot parse '{pat}' from {path!r}")
        return int(m.group(1))

    def _float(pat: str) -> float:
        m = re.search(pat, info.stdout)
        if m is None:
            raise RuntimeError(f"grdinfo: cannot parse '{pat}' from {path!r}")
        return float(m.group(1))

    ncols = _int(r"n_columns:\s*(\d+)")
    nrows = _int(r"n_rows:\s*(\d+)")
    x_min = _float(r"x_min:\s*([\d.eE+\-]+)")
    x_max = _float(r"x_max:\s*([\d.eE+\-]+)")
    y_min = _float(r"y_min:\s*([\d.eE+\-]+)")
    y_max = _float(r"y_max:\s*([\d.eE+\-]+)")
    x_inc_m = re.search(r"x_inc:\s*([\d.eE+\-]+)", info.stdout)
    y_inc_m = re.search(r"y_inc:\s*([\d.eE+\-]+)", info.stdout)
    x_inc = float(x_inc_m.group(1)) if x_inc_m else (x_max - x_min) / (ncols - 1)
    y_inc = float(y_inc_m.group(1)) if y_inc_m else (y_max - y_min) / (nrows - 1)
    reg_m = re.search(r"(Pixel|Gridline) node registration", info.stdout)
    registration = 1 if (reg_m and "Pixel" in reg_m.group(1)) else 0

    # grd2xyz binary output: 3 float32 per node, row-major top-to-bottom
    xyz = subprocess.run(
        [gmt, "grd2xyz", "-bo3f", path],
        capture_output=True
    )
    if xyz.returncode != 0:
        raise RuntimeError(f"gmt grd2xyz failed on {path!r}: {xyz.stderr.strip()}")
    arr = np.frombuffer(xyz.stdout, dtype=np.float32)
    if arr.size != ncols * nrows * 3:
        raise RuntimeError(
            f"grd2xyz output size {arr.size} != {ncols*nrows*3} for {path!r}"
        )
    data = arr.reshape(nrows, ncols, 3)[:, :, 2].copy()  # shape (nrows, ncols)

    hdr = dict(
        ncols=ncols, nrows=nrows,
        x_min=x_min, x_max=x_max, y_min=y_min, y_max=y_max,
        x_inc=x_inc, y_inc=y_inc, registration=registration,
    )
    return data, hdr


def _write_grd(data: np.ndarray, hdr: dict, path: str,
               title: str = "", remark: str = "") -> None:
    """Write float32 array as a GMT netCDF grid via `gmt xyz2grd`.

    `data` must be shape (nrows, ncols), float32, row 0 = top (y_max end)
    as returned by _read_grd().

    Pixel-registered grids (registration=1): node centres are at
    x_min + x_inc/2, …, x_max - x_inc/2  (as grd2xyz returns them).
    The outer bounds -R are still x_min/x_max/y_min/y_max.
    """
    gmt = _gmt_bin()
    nrows, ncols = data.shape
    x_min = hdr["x_min"]
    x_max = hdr["x_max"]
    y_min = hdr["y_min"]
    y_max = hdr["y_max"]
    x_inc = hdr["x_inc"]
    y_inc = hdr["y_inc"]
    reg = hdr.get("registration", 1)

    # Build node-centre coordinates matching grd2xyz output order
    if reg == 1:  # pixel registration: centres at min+inc/2 … max-inc/2
        xs = np.arange(x_min + x_inc / 2.0, x_max, x_inc, dtype=np.float64)
        ys = np.arange(y_max - y_inc / 2.0, y_min, -y_inc, dtype=np.float64)
    else:  # gridline: centres at min, min+inc, …, max
        xs = np.linspace(x_min, x_max, ncols, dtype=np.float64)
        ys = np.linspace(y_max, y_min, nrows, dtype=np.float64)

    # Trim/pad to exact grid size (floating-point linspace can overshoot)
    xs = xs[:ncols]
    ys = ys[:nrows]

    xx = xs.astype(np.float32)[None, :].repeat(nrows, axis=0)   # (nrows, ncols)
    yy = ys.astype(np.float32)[:, None].repeat(ncols, axis=1)    # (nrows, ncols)
    xyz = np.stack([xx, yy, data.astype(np.float32)], axis=-1)   # (nrows, ncols, 3)
    raw = xyz.astype(np.float32).tobytes()

    region = f"{x_min}/{x_max}/{y_min}/{y_max}"
    inc = f"{x_inc}/{y_inc}"

    cmd = [gmt, "xyz2grd", f"-G{path}",
           f"-R{region}", f"-I{inc}", "-bi3f"]
    if reg == 1:
        cmd.append("-r")  # pixel registration

    proc = subprocess.run(cmd, input=raw, capture_output=True)
    if proc.returncode != 0:
        raise RuntimeError(
            f"gmt xyz2grd failed writing {path!r}: {proc.stderr.strip()!r}"
        )


def _make_wgt(nxp: int, nyp: int) -> np.ndarray:
    """Bilinear tent window matching C make_wgt() exactly.

    C source (phasefilt.c:109-126):
        for i in 0..nyp/2:
            wy = 1 - |i - (nyp/2 - 1)| / (nyp/2 - 1)
            for j in 0..nxp/2:
                wx = 1 - |j - (nxp/2 - 1)| / (nxp/2 - 1)
                wgt[i*nxp+j] = wgt[(i+1)*nxp-j-1] = wx*wy
                wgt[(nyp-i-1)*nxp+j] = wgt[(nyp-i)*nxp-j-1] = wx*wy

    Note: wgt[0,*] = wgt[nyp-1,*] = wgt[*,0] = wgt[*,nxp-1] = 0
    because i=0 → wy=0 and j=0 → wx=0.
    """
    wgt = np.zeros((nyp, nxp), dtype=np.float32)
    half_y = nyp // 2
    half_x = nxp // 2
    for i in range(half_y):
        wy = np.float32(1.0) - np.float32(
            abs(float(i) - (nyp / 2.0 - 1.0)) / (nyp / 2.0 - 1.0)
        )
        for j in range(half_x):
            wx = np.float32(1.0) - np.float32(
                abs(float(j) - (nxp / 2.0 - 1)) / (nxp / 2.0 - 1.0)
            )
            val = wx * wy
            wgt[i, j] = val
            wgt[i, nxp - j - 1] = val
            wgt[nyp - i - 1, j] = val
            wgt[nyp - i - 1, nxp - j - 1] = val
    return wgt


def _calc_corr(re_data: np.ndarray, im_data: np.ndarray,
               amp1: np.ndarray, amp2: np.ndarray) -> np.ndarray:
    """Coherence estimate matching C calc_corr() exactly.

    C source (phasefilt.c:145-179):
        a = A1->data[i] * A2->data[i]
        if a > 0: corr[i] = amp[i] / sqrt(a)  clipped to [0,1]
        else:     corr[i] = 0

    where amp[i] = sqrt(re^2 + im^2).
    """
    amp = np.sqrt(re_data.astype(np.float32)**2 +
                  im_data.astype(np.float32)**2).astype(np.float32)
    a = (amp1 * amp2).astype(np.float32)
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", RuntimeWarning)
        corr = np.where(a > 0.0, amp / np.sqrt(a), np.float32(0.0)).astype(np.float32)
    corr = np.clip(corr, np.float32(0.0), np.float32(1.0))
    return corr, amp


def _apply_pspec(F: np.ndarray, alpha: float) -> np.ndarray:
    """Multiply spectrum by |F|^alpha in float32, matching C apply_pspec().

    C source (phasefilt.c:129-143):
        wgt = pow(re^2 + im^2, alpha/2)
        out = wgt * in

    Uses float32 arithmetic throughout to match C powf().
    """
    alpha_f = np.float32(alpha)
    r2i2 = (F.real.astype(np.float32)**2 +
             F.imag.astype(np.float32)**2)
    w = np.power(r2i2, alpha_f / np.float32(2.0))
    return (w.astype(np.complex64) * F.astype(np.complex64)).astype(np.complex64)


def _goldstein_filter(
    cdata: np.ndarray,
    corr: Optional[np.ndarray],
    wgt: np.ndarray,
    psize: int,
    alpha_const: float,
    workers: int = -1,
) -> np.ndarray:
    """Core Goldstein/Baran patch filter loop.

    Vectorized: processes all patches along the column dimension in one
    batched fft2 call per row-stride.  Each "row-stripe" is all patches
    starting at a fixed ii with jj varying.  This gives a 10–30× speedup
    over the pure-scalar loop while matching C output to float32 roundoff.

    C loop (phasefilt.c:437-474):
        for ii in range(0, ydim-nyp, nyp//2):
          for jj in range(0, xdim-nxp, nxp//2):
            ... FFT patch, apply_pspec, IFFT, weighted accumulate ...

    The row-stripe vectorisation gathers all jj patches for each ii into a
    (n_col_patches, psize, psize) array, calls fft2 once, applies pspec per
    patch (alpha is per-patch in Baran mode), then IFFT and scatters back.
    alpha must be computed per patch before batching; we do that in a small
    Python loop over jj (cheap, no FFT).
    """
    ydim, xdim = cdata.shape
    nyp = nxp = psize
    step = psize // 2
    corrflag = corr is not None

    fdata = np.zeros((ydim, xdim), dtype=np.complex64)
    swgt = np.float32(np.sum(wgt))  # constant across all patches

    for ii in range(0, ydim - nyp, step):
        # Gather all column patches for this row offset
        jj_vals = list(range(0, xdim - nxp, step))
        n_patches = len(jj_vals)
        if n_patches == 0:
            continue

        # batch_patches: (n_patches, nyp, nxp) complex64
        batch = np.stack(
            [cdata[ii:ii+nyp, jj:jj+nxp] for jj in jj_vals],
            axis=0,
        ).astype(np.complex64)

        # Compute per-patch alpha (Baran) — scalar loop, but cheap (no FFT)
        if corrflag:
            alphas = np.empty(n_patches, dtype=np.float32)
            for k, jj in enumerate(jj_vals):
                pcorr = np.float32(
                    np.sum(wgt * corr[ii:ii+nyp, jj:jj+nxp])
                )
                alphas[k] = np.float32(1.0) - pcorr / swgt
        else:
            alphas = np.full(n_patches, np.float32(alpha_const), dtype=np.float32)

        # Batched forward FFT: (n_patches, nyp, nxp) → complex64
        if workers is not None and workers != 0:
            F_batch = _fft2(batch, workers=workers)
        else:
            F_batch = _fft2(batch)

        # Per-patch apply_pspec (alpha differs per patch in Baran mode)
        # F_batch shape: (n_patches, nyp, nxp)
        r2i2 = (F_batch.real.astype(np.float32)**2 +
                F_batch.imag.astype(np.float32)**2)  # (n, nyp, nxp) float32

        # alphas: (n,) → broadcast over (nyp, nxp)
        half_alpha = (alphas / np.float32(2.0))[:, None, None]  # (n,1,1)
        w = np.power(r2i2, half_alpha).astype(np.float32)         # (n, nyp, nxp)
        F1 = (w.astype(np.complex64) * F_batch.astype(np.complex64))

        # Batched inverse FFT
        if workers is not None and workers != 0:
            patch1_batch = _ifft2(F1, workers=workers)
        else:
            patch1_batch = _ifft2(F1)
        patch1_batch = patch1_batch.astype(np.complex64)

        # Weighted scatter-accumulate back (wgt is the same for all patches)
        for k, jj in enumerate(jj_vals):
            fdata[ii:ii+nyp, jj:jj+nxp] += (wgt * patch1_batch[k]).astype(np.complex64)

    return fdata


# -------------------------------------------------------------- I/O helpers --

def _check_same_dims(hdr_a: dict, path_a: str,
                     hdr_b: dict, path_b: str) -> None:
    if hdr_a["ncols"] != hdr_b["ncols"] or hdr_a["nrows"] != hdr_b["nrows"]:
        raise RuntimeError(
            f"Grid dimensions mismatch: "
            f"{path_a!r} = {hdr_a['ncols']}×{hdr_a['nrows']}, "
            f"{path_b!r} = {hdr_b['ncols']}×{hdr_b['nrows']}"
        )


# --------------------------------------------------------------- CLI entry ---

def _parse_args(argv=None):
    p = argparse.ArgumentParser(
        prog="phasefilt_py",
        description="Adaptive phase filter (Goldstein/Baran) — Python port of gmtsar phasefilt",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("-imag", required=True, metavar="FILE",
                   help="GMT format imaginary component grid (required)")
    p.add_argument("-real", required=True, metavar="FILE",
                   help="GMT format real component grid (required)")
    p.add_argument("-alpha", type=float, default=0.5, metavar="A",
                   help="Filter exponent 0.0–1.5 (default 0.5); ignored if -amp1/-amp2 given")
    p.add_argument("-psize", type=int, default=32, metavar="P",
                   help="Patch size (power of 2; default 32)")
    p.add_argument("-amp1", metavar="FILE", default=None,
                   help="Amplitude image 1 (enables Baran coherence-adaptive alpha)")
    p.add_argument("-amp2", metavar="FILE", default=None,
                   help="Amplitude image 2 (required if -amp1 given)")
    p.add_argument("-diff", action="store_true",
                   help="Write phase difference input-output to filtdiff.grd")
    p.add_argument("-complex_out", action="store_true",
                   help="Write filtered real/imag to filtphase_real.grd and filtphase_imag.grd")
    p.add_argument("-phasefilt", metavar="FILE", default="filtphase.grd",
                   help="Output filtered phase filename (default: filtphase.grd)")
    p.add_argument("-corrfilt", metavar="FILE", default="filtcorr.grd",
                   help="Output coherence filename (default: filtcorr.grd)")
    p.add_argument("-v", action="store_true", help="Verbose")
    p.add_argument("-workers", type=int, default=_WORKERS_DEFAULT, metavar="N",
                   help="FFT worker threads (-1=all cores; Py-only flag)")
    args = p.parse_args(argv)

    # Validation mirrors C parse logic
    if (args.amp1 is None) != (args.amp2 is None):
        p.error("both -amp1 and -amp2 must be given together (Baran filter)")

    if args.amp1 is not None:
        # Baran mode: alpha driven by coherence, not CLI value
        args.alpha = -1.0  # sentinel as in C
        if args.v:
            print("phasefilt_py: using coherence-dependent alpha (1 - gamma)",
                  file=sys.stderr)
    else:
        if args.v:
            print(f"phasefilt_py: constant alpha ({args.alpha:6.2f})",
                  file=sys.stderr)

    return args


def main(argv=None) -> int:
    args = _parse_args(argv)
    corrflag = args.alpha < 0.0  # True → Baran mode

    # ---- B2: read real + imag -------------------------------------------
    if args.v:
        print(f"phasefilt_py: reading {args.real!r}", file=sys.stderr)
    re_data, hdr = _read_grd(args.real)
    if args.v:
        print(f"phasefilt_py: reading {args.imag!r}", file=sys.stderr)
    im_data, hdr_im = _read_grd(args.imag)
    _check_same_dims(hdr, args.real, hdr_im, args.imag)
    re_data = re_data.astype(np.float32)
    im_data = im_data.astype(np.float32)

    ydim, xdim = re_data.shape
    psize = args.psize

    # ---- B3: coherence (Baran) -----------------------------------------
    corr = None
    amp = None
    if corrflag:
        if args.v:
            print(f"phasefilt_py: reading amp1={args.amp1!r}", file=sys.stderr)
        a1_data, hdr_a1 = _read_grd(args.amp1)
        _check_same_dims(hdr, args.real, hdr_a1, args.amp1)
        if args.v:
            print(f"phasefilt_py: reading amp2={args.amp2!r}", file=sys.stderr)
        a2_data, hdr_a2 = _read_grd(args.amp2)
        _check_same_dims(hdr, args.real, hdr_a2, args.amp2)
        corr, amp = _calc_corr(re_data, im_data,
                                a1_data.astype(np.float32),
                                a2_data.astype(np.float32))
    else:
        amp = np.sqrt(re_data**2 + im_data**2).astype(np.float32)

    # ---- B4: weight window ---------------------------------------------
    wgt = _make_wgt(psize, psize)

    # ---- B5/B6: patch filter loop -------------------------------------
    cdata = (re_data + 1j * im_data).astype(np.complex64)
    fdata = _goldstein_filter(
        cdata, corr, wgt, psize,
        alpha_const=args.alpha,
        workers=args.workers,
    )

    # ---- output phase --------------------------------------------------
    outphase = np.arctan2(fdata.imag, fdata.real).astype(np.float32)

    # ---- B7: write grids -----------------------------------------------
    if args.v:
        print(f"phasefilt_py: writing {args.phasefilt!r}", file=sys.stderr)
    _write_grd(outphase, hdr, args.phasefilt, remark="phase")

    if corrflag and corr is not None:
        if args.v:
            print(f"phasefilt_py: writing {args.corrfilt!r}", file=sys.stderr)
        _write_grd(corr, hdr, args.corrfilt, remark="corr")

    if args.complex_out:
        _write_grd(fdata.real.astype(np.float32), hdr,
                   "filtphase_real.grd", remark="real")
        _write_grd(fdata.imag.astype(np.float32), hdr,
                   "filtphase_imag.grd", remark="imag")

    if args.diff:
        orig_phase = np.arctan2(im_data, re_data).astype(np.float32)
        _write_grd((orig_phase - outphase).astype(np.float32), hdr,
                   "filtdiff.grd", remark="diff")

    return 0


if __name__ == "__main__":
    sys.exit(main())
