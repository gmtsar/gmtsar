#! /usr/bin/env python3
"""xcorr_py — Python port of gmtsar `xcorr` (freq-mode only).

Line-by-line port of the C source under gmtsar/gmtsar/:

  parse_xcorr_input.c   → set_defaults + parse_command_line
  xcorr.c               → assign_values + do_correlation + make_mask
  get_locations.c       → get_locations
  read_xcorr_data.c     → read_complex_short2
  do_freq_xcorr.c       → fft_multiply + do_freq_corr
  do_time_int_xcorr.c   → calc_time_corr  (called by freq mode too)
  highres_corr.c        → do_highres_corr (sub-pixel via 16× FFT zero-pad)
  print_results.c       → print_results
  fft_interpolate_routines.c → fft_interpolate_1d + _2d

The prior stub did complex correlation, no masking, wrong patch sizing
(npx = nx_corr + 2·xsearch — the C uses npx = 4·xsearch when -xsearch is
given), wrong grid (x_inc formula didn't match get_locations.c), and
swapped output columns (wrote `r a dr da SNR` instead of `r dr a da SNR`).
That stub passed its self-consistency unit tests but produced
freq_xcorr.dat rows hundreds of pixels off C — which is why this port
exists.

Per memory rule `feedback-binpy-c-parity-tests`: every bin_py port must
be tested for float-roundoff-equal output to the corresponding C binary
on the same input, NOT internal self-consistency.

CLI mirrors `xcorr`:
    xcorr_py master.PRM aligned.PRM [-time | -freq] [-nx N] [-ny N]
      [-xsearch S] [-ysearch S] [-noshift] [-nointerp]
      [-interp F] [-range_interp R] [-norange]
Defaults: -freq, -nx 16, -ny 32, -xsearch 64, -ysearch 64,
          ri=2, interp_factor=16.
"""
from __future__ import annotations

import argparse
import mmap
import os
import sys
import time
from dataclasses import dataclass, field

import numpy as np


def _advise_sequential(arr):
    """Hint the kernel that this memmap will be read sequentially.

    Mira #35 / #37: under NFS, np.memmap default access is per-4 KB-page
    demand-fault, which triggers a separate NFS RPC for each page
    (Mira #32: 1.15M minor faults; 5x slowdown under parallel sweep
    contention). MADV_SEQUENTIAL tells the kernel to read-ahead in
    larger chunks. Linux-only; falls back silently on macOS/BSD or if
    MADV_SEQUENTIAL is unavailable.
    """
    try:
        m = arr.base
        while m is not None and not isinstance(m, mmap.mmap):
            m = getattr(m, "base", None)
        if m is None:
            return
        madvise = getattr(m, "madvise", None)
        advice = getattr(mmap, "MADV_SEQUENTIAL", None)
        if madvise is None or advice is None:
            return
        madvise(advice)
    except (AttributeError, OSError, ValueError):
        pass

try:
    from scipy.fft import fft2 as _fft2, ifft2 as _ifft2, fft as _fft1, ifft as _ifft1
    # _W = number of threads for scipy.fft. -1 = all cores (production
    # default). Set XCORR_PY_WORKERS=1 to force single-thread (apples-to-
    # apples vs C single-thread xcorr). Any positive int is accepted.
    _W = int(os.environ.get("XCORR_PY_WORKERS", "-1"))
except Exception:  # pragma: no cover
    _fft2 = np.fft.fft2; _ifft2 = np.fft.ifft2
    _fft1 = np.fft.fft;  _ifft1 = np.fft.ifft
    _W = None


# ---------------------------------------------------------------- PRM ---
def _read_prm(path: str) -> dict:
    out: dict[str, str] = {}
    with open(path) as f:
        for line in f:
            if "=" not in line: continue
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip()
    return out

def _i(prm: dict, k: str, default: int = 0) -> int:
    v = prm.get(k, "").split()
    return int(float(v[0])) if v else default

def _f(prm: dict, k: str, default: float = 0.0) -> float:
    v = prm.get(k, "").split()
    return float(v[0]) if v else default

def _s(prm: dict, k: str, default: str = "") -> str:
    v = prm.get(k, "").split()
    return v[0] if v else default


# ------------------------------------------------------------- struct ---
@dataclass
class XCorr:
    # input geometry
    m_nx: int = 0; m_ny: int = 0
    s_nx: int = 0; s_ny: int = 0
    x_offset: int = 0       # rshift from aligned PRM
    y_offset: int = 0       # ashift from aligned PRM
    astretcha: float = 0.0
    # grid layout
    nxl: int = 16; nyl: int = 32
    # search / window sizes (mirror C exactly)
    xsearch: int = 64; ysearch: int = 64
    nx_corr: int = 128; ny_corr: int = 128
    npx: int = 256; npy: int = 256
    nxc: int = 128; nyc: int = 128
    # mode flags
    corr_flag: int = 2          # 2 = freq (only mode implemented)
    interp_flag: int = 1
    interp_factor: int = 16
    ri: int = 2                 # range-interpolation factor
    n2x: int = 8; n2y: int = 8  # highres-corr matrix size (power of 2)
    offset_flag: int = 0
    # data
    data1_path: str = ""; data2_path: str = ""
    mm1: np.ndarray | None = None
    mm2: np.ndarray | None = None
    # computed
    x_inc: int = 0; y_inc: int = 0
    loc: np.ndarray = field(default_factory=lambda: np.zeros((0, 2), dtype=np.int64))


# ------------------------------------------------------------ defaults ---
def set_defaults(xc: XCorr) -> None:
    """Mirror parse_xcorr_input.c:set_defaults exactly (corr_flag=2 branch)."""
    xc.nxl = 16; xc.nyl = 32
    xc.x_offset = 0; xc.y_offset = 0
    xc.nx_corr = 128; xc.ny_corr = 128
    xc.xsearch = 64;  xc.ysearch = 64
    xc.n2x = 8; xc.n2y = 8
    xc.npx = xc.nx_corr + 2 * xc.xsearch
    xc.npy = xc.ny_corr + 2 * xc.ysearch
    xc.nxc = 2 * xc.xsearch
    xc.nyc = 2 * xc.ysearch
    xc.astretcha = 0.0
    xc.interp_flag = 1
    xc.interp_factor = 16
    xc.ri = 2

def apply_xsearch(xc: XCorr, xsearch: int) -> None:
    """Mirror the -xsearch branch of parse_command_line."""
    if xsearch <= 0 or (xsearch - 1) & xsearch:
        raise ValueError(f"xsearch needs to be power of 2: {xsearch}")
    xc.xsearch = xsearch
    xc.nx_corr = 2 * xsearch
    xc.npx = xc.nx_corr + 2 * xsearch        # = 4·xsearch
    xc.nxc = 2 * xsearch

def apply_ysearch(xc: XCorr, ysearch: int) -> None:
    if ysearch <= 0 or (ysearch - 1) & ysearch:
        raise ValueError(f"ysearch needs to be power of 2: {ysearch}")
    xc.ysearch = ysearch
    xc.ny_corr = 2 * ysearch
    xc.npy = xc.ny_corr + 2 * ysearch
    xc.nyc = 2 * ysearch


# ------------------------------------------------------------- handle PRM ---
def handle_prm(xc: XCorr, m_path: str, a_path: str) -> None:
    """Mirror parse_xcorr_input.c:handle_prm (PRM branch)."""
    pm = _read_prm(m_path); pa = _read_prm(a_path)

    xc.data1_path = _s(pm, "SLC_file")
    if xc.data1_path and not os.path.isabs(xc.data1_path):
        xc.data1_path = os.path.join(os.path.dirname(m_path) or ".",
                                     xc.data1_path)
    xc.m_nx = _i(pm, "num_rng_bins")
    xc.m_ny = _i(pm, "num_patches") * _i(pm, "num_valid_az")

    xc.data2_path = _s(pa, "SLC_file")
    if xc.data2_path and not os.path.isabs(xc.data2_path):
        xc.data2_path = os.path.join(os.path.dirname(a_path) or ".",
                                     xc.data2_path)
    xc.s_nx = _i(pa, "num_rng_bins")
    xc.s_ny = _i(pa, "num_patches") * _i(pa, "num_valid_az")
    xc.x_offset = _i(pa, "rshift")
    xc.y_offset = _i(pa, "ashift")

    prf0 = _f(pm, "PRF"); prf1 = _f(pa, "PRF")
    xc.astretcha = (prf1 - prf0) / prf0 if prf0 > 0 else 0.0

    if xc.offset_flag == 1:
        xc.x_offset = xc.y_offset = 0
        print(" setting ashift and rshift to zero", file=sys.stderr)

    # Memmap SLCs (int16 real + int16 imag interleaved, row-major).
    sz_m = os.path.getsize(xc.data1_path) // (xc.m_nx * 4)
    sz_a = os.path.getsize(xc.data2_path) // (xc.s_nx * 4)
    xc.mm1 = np.memmap(xc.data1_path, dtype=np.int16, mode="r",
                       shape=(sz_m, xc.m_nx, 2))
    _advise_sequential(xc.mm1)  # Mira #37: avoid NFS per-page fault storms
    xc.mm2 = np.memmap(xc.data2_path, dtype=np.int16, mode="r",
                       shape=(sz_a, xc.s_nx, 2))
    _advise_sequential(xc.mm2)  # Mira #37: avoid NFS per-page fault storms

    print(f" {xc.m_nx} {xc.m_ny} {xc.s_nx} {xc.s_ny} "
          f"{xc.x_offset} {xc.y_offset} {xc.astretcha:f}", file=sys.stderr)


# ------------------------------------------------------ get_locations ---
def get_locations(xc: XCorr) -> None:
    """Mirror get_locations.c exactly.

    x_inc = (m_nx - 2·(xsearch + nx_corr)) / (nxl + 3)
    y_inc = (m_ny - 2·(ysearch + ny_corr)) / (nyl + 1)
    For j in [1, nyl], i in [2, nxl+1]:
        loc.x = npx + i·x_inc
        loc.y = npy + j·y_inc
    (i starts at 2 because C drops the first range column.)
    """
    xc.x_inc = (xc.m_nx - 2 * (xc.xsearch + xc.nx_corr)) // (xc.nxl + 3)
    xc.y_inc = (xc.m_ny - 2 * (xc.ysearch + xc.ny_corr)) // (xc.nyl + 1)
    locs = []
    for j in range(1, xc.nyl + 1):
        for i in range(2, xc.nxl + 2):
            locs.append((xc.npx + i * xc.x_inc, xc.npy + j * xc.y_inc))
    xc.loc = np.array(locs, dtype=np.int64)
    print(f" locations  n {len(locs)} nx {xc.m_nx} nyl {xc.nyl} "
          f"nxl {xc.nxl} x_inc {xc.x_inc} y_inc {xc.y_inc}",
          file=sys.stderr)


# ------------------------------------------------- range interpolate ---
def _range_interpolate_rows(c: np.ndarray, ri: int) -> np.ndarray:
    """Mirror xcorr.c:do_range_interpolate applied per row.

    Per the C code: forward FFT (length nx) → zero-pad to ri·nx using
    fft_arrange_interpolate (low half at [0:nx/2], high half at
    [(2·ri−1)·nx/2 : ((2·ri−1)·nx/2)+nx/2]) → inverse FFT (length ri·nx)
    → multiply by ri. Then keep the central nx samples
    (g[..., nx/2 : 3·nx/2])."""
    if ri <= 1:
        return c
    nx = c.shape[-1]
    M = ri * nx
    half = nx // 2
    F = _fft1(c, n=nx, axis=-1, workers=_W) if _W else _fft1(c, n=nx, axis=-1)
    G = np.zeros(c.shape[:-1] + (M,), dtype=c.dtype)
    G[..., :half] = F[..., :half]
    G[..., (2 * ri - 1) * half : (2 * ri - 1) * half + half] = F[..., half:nx]
    g = _ifft1(G, n=M, axis=-1, workers=_W) if _W else _ifft1(G, n=M, axis=-1)
    g = (ri * g).astype(c.dtype)
    return g[..., half : half + nx]


# ----------------------------------------------------------- mask ---
def make_mask(xc: XCorr) -> np.ndarray:
    """Mirror xcorr.c:make_mask — 1 in the central nx_corr×ny_corr block,
    0 in the (xsearch, ysearch)-wide border."""
    m = np.zeros((xc.npy, xc.npx), dtype=np.float32)
    m[xc.ysearch : xc.npy - xc.ysearch,
      xc.xsearch : xc.npx - xc.xsearch] = 1.0
    return m


# ---------------------------------------- assign_values + freq corr ---
def _process_location(xc: XCorr, x: int, y: int, mask: np.ndarray,
                      d1_row: np.ndarray, d2_row: np.ndarray
                      ) -> tuple[float, float, float, float, float]:
    """Mirror assign_values + do_freq_corr + calc_time_corr + highres_corr
    for one location. Returns (xoff, yoff, xfrac, yfrac, corr)."""
    npx, npy = xc.npx, xc.npy
    nxc, nyc = xc.nxc, xc.nyc

    mx = x - npx // 2
    sx = x + xc.x_offset - npx // 2

    # Extract npy × npx complex patches.
    p1 = d1_row[:, mx:mx + npx, :].astype(np.float32)
    p2 = d2_row[:, sx:sx + npx, :].astype(np.float32)
    c1 = (p1[..., 0] + 1j * p1[..., 1]).astype(np.complex64)
    c2 = (p2[..., 0] + 1j * p2[..., 1]).astype(np.complex64)

    if xc.ri > 1:
        c1 = _range_interpolate_rows(c1, xc.ri)
        c2 = _range_interpolate_rows(c2, xc.ri)

    # to amplitude + demean (C does this on float, with double-precision mean)
    a1 = np.abs(c1).astype(np.float32)
    a2 = np.abs(c2).astype(np.float32)
    a1 = a1 - np.float32(a1.mean(dtype=np.float64))
    a2 = a2 - np.float32(a2.mean(dtype=np.float64))

    # Mask aligned only (C: c2[i].r *= mask[i])
    a2_masked = a2 * mask

    # Integer-truncated versions for calc_time_corr (matches xc->i1, xc->i2)
    i1 = a1.astype(np.int32)
    i2 = a2_masked.astype(np.int32)

    # fft_multiply: FFT2(a1) · conj(FFT2(a2_masked)) · (-1)^(i+j)
    F1 = _fft2(a1.astype(np.complex64), workers=_W) if _W else _fft2(a1.astype(np.complex64))
    F2 = _fft2(a2_masked.astype(np.complex64), workers=_W) if _W else _fft2(a2_masked.astype(np.complex64))
    sign = (((np.arange(npy)[:, None] + np.arange(npx)[None, :]) & 1)
            .astype(np.float32) * -2 + 1)
    prod = sign * (F1 * np.conj(F2))
    c3 = _ifft2(prod, workers=_W) if _W else _ifft2(prod)

    # Build correlation surface: corr[i, j] = |c3[i + ny_corr/2, j + nx_corr/2]|
    half_yc = xc.ny_corr // 2
    half_xc = xc.nx_corr // 2
    corr = np.abs(c3[half_yc:half_yc + nyc,
                     half_xc:half_xc + nxc]).astype(np.float64)

    flat = int(corr.argmax())
    ip, jp = divmod(flat, nxc)
    cmax = float(corr[ip, jp])
    ipeak = ip - nyc / 2.0
    jpeak = jp - nxc / 2.0

    # calc_time_corr at (ioff=int(ipeak), joff=int(jpeak))
    ioff = int(ipeak); joff = int(jpeak)
    A = i1[xc.ysearch + ioff : xc.ysearch + ioff + xc.ny_corr,
           xc.xsearch + joff : xc.xsearch + joff + xc.nx_corr].astype(np.int64)
    B = i2[xc.ysearch : xc.ysearch + xc.ny_corr,
           xc.xsearch : xc.xsearch + xc.nx_corr].astype(np.int64)
    num = int((A * B).sum())
    den1 = int((A * A).sum())
    den2 = int((B * B).sum())
    den_sq = den1 * den2
    max_corr = 100.0 * abs(num) / (den_sq ** 0.5) if den_sq > 0 else 0.0

    # rescale correlation surface (only matters for highres_corr below)
    if cmax > 0:
        corr_scaled = (max_corr / cmax) * corr
    else:
        corr_scaled = corr

    xoff = float(-jpeak)
    yoff = float(-ipeak)

    if xc.interp_flag == 1:
        xfrac, yfrac = _do_highres_corr(xc, corr_scaled, xoff, yoff)
    else:
        xfrac = yfrac = 0.0

    return xoff, yoff, xfrac, yfrac, max_corr


def _do_highres_corr(xc: XCorr, corr_scaled: np.ndarray,
                     xoff: float, yoff: float) -> tuple[float, float]:
    """Mirror highres_corr.c:do_highres_corr — 16× FFT zero-pad over an
    n2x×n2y region centered on the integer peak. Returns (xfrac, yfrac)."""
    ifc = xc.interp_factor
    nx = xc.n2x; ny = xc.n2y
    nx2 = ifc * nx; ny2 = ifc * ny

    jc = (xc.nxc // 2) - nx // 2 - int(xoff)
    ic = (xc.nyc // 2) - ny // 2 - int(yoff)

    md = np.zeros((ny, nx), dtype=np.complex64)
    for i in range(ny):
        kr = ic + i
        if kr < 0 or kr >= xc.nyc:
            continue
        for j in range(nx):
            kc = jc + j
            if kc < 0 or kc >= xc.nxc:
                continue
            md[i, j] = np.complex64(corr_scaled[kr, kc] ** 0.25)

    cd_exp = _fft_interpolate_2d(md, ny2, nx2, ifc)

    # find peak; C uses cd_exp[i*nx2 + j].r (real part), and replicates
    # the (probably-buggy) `ny2/2` for the column subtraction.
    real = cd_exp.real
    flat = int(real.argmax())
    ip, jp = divmod(flat, nx2)
    ipeak = ip - ny2 // 2
    jpeak = jp - ny2 // 2       # C uses ny2/2 — replicate exactly

    return float(jpeak / ifc), float(ipeak / ifc)


# ----------------------------------------------- fft_interpolate_2d ---
def _fft_arrange_interpolate(F: np.ndarray, M: int, ifactor: int) -> np.ndarray:
    N = F.shape[-1]; N2 = N // 2
    out = np.zeros(F.shape[:-1] + (M,), dtype=F.dtype)
    out[..., :N2] = F[..., :N2]
    out[..., (2 * ifactor - 1) * N2 : (2 * ifactor - 1) * N2 + N2] = F[..., N2:N]
    return out


def _fft_interpolate_1d(c: np.ndarray, ifactor: int) -> np.ndarray:
    N = c.shape[-1]; M = ifactor * N
    F = _fft1(c, n=N, axis=-1, workers=_W) if _W else _fft1(c, n=N, axis=-1)
    G = _fft_arrange_interpolate(F, M, ifactor)
    g = _ifft1(G, n=M, axis=-1, workers=_W) if _W else _ifft1(G, n=M, axis=-1)
    return (ifactor * g).astype(c.dtype)


def _fft_interpolate_2d(md: np.ndarray, ny2: int, nx2: int,
                        ifactor: int) -> np.ndarray:
    N1, M1 = md.shape
    tmp1 = _fft_interpolate_1d(md, ifactor)              # rows → (N1, nx2)
    # transpose + interp + transpose back
    tmp1_T = tmp1.T                                       # (nx2, N1)
    tmp2 = _fft_interpolate_1d(tmp1_T, ifactor)          # (nx2, ny2)
    return tmp2.T                                         # (ny2, nx2)


# ----------------------------------------------------- do_correlation ---
class _StaleRowReader:
    """Mirror C `read_complex_short2`'s per-row `fread` semantics, including
    the stale-`tmp[]` behaviour past EOF that the parity oracle depends on.

    C does:
        for (i = 0; i < npy; i++) {
            fread(&tmp[0], 2*sizeof(short), nx, f);   // EOF → tmp unchanged
            for (j = 0; j < nx; j++) { d[i*nx+j] = tmp[j]; }
        }
    so an OOB row inherits the LAST successfully-read row's bytes. The
    `tmp` buffer is freshly malloc'd inside `read_xcorr_data` (heap-backed
    at this size, not mmap'd), and across the nyl outer-loop iterations
    glibc's small-bin allocator typically returns the same chunk, so its
    state effectively persists across calls. The dominant behaviour on
    the gmtsar parity host is:
        * partial-OOB row band → OOB rows = last valid row of THIS call;
        * fully-OOB row band  → OOB rows = last valid row of any PRIOR
                                 call (with zero-init on the very first
                                 call, matching Linux glibc 20 KB sbrk
                                 zero-fill).

    Prior `_read_npy_zero_pad` zero-padded OOB rows instead, which made
    the correlation surface at y=5084-5592 (NISAR_Ethiopia) diverge from
    C — passing/dropping different SNR>20 rows than the C oracle and
    pushing trend2d → r.grd → resamp → intf off, breaking phasefilt /
    filtcorr / display_amp_ll / phasefilt_mask_ll downstream."""

    def __init__(self, mm: np.ndarray):
        self.mm = mm
        # Persistent tmp[] — shape (nx, 2), int16. Init to zeros to
        # match Linux 20 KB malloc on first call.
        self.tmp = np.zeros(mm.shape[1:], dtype=mm.dtype)

    def read(self, iy: int, npy: int) -> np.ndarray:
        ny = self.mm.shape[0]
        out = np.empty((npy,) + self.mm.shape[1:], dtype=self.mm.dtype)
        # Vectorised happy path: full-valid range → bulk memmap slice.
        if 0 <= iy and iy + npy <= ny:
            out[:] = self.mm[iy:iy + npy]
            self.tmp = np.asarray(self.mm[iy + npy - 1]).copy()
            return out
        # Partial / fully OOB → per-row C-faithful loop.
        for i in range(npy):
            r = iy + i
            if 0 <= r < ny:
                self.tmp = np.asarray(self.mm[r]).copy()
            out[i] = self.tmp
        return out


def do_correlation(xc: XCorr, out_path: str) -> None:
    """Mirror xcorr.c:do_correlation. Outer y loop reads npy lines of
    each SLC once, inner x loop processes nxl patches in that band.

    Boundary handling: see `_StaleRowReader` — C `fread` short-reads
    past EOF leave the trailing buffer with prior-row data, so OOB
    rows of the aligned patch inherit the LAST VALID ROW READ, not
    zeros. Mirroring this is required for parity when ashift pushes
    the aligned patch past EOF (NISAR_Ethiopia: y=5084-5465 partial-
    OOB, y=5592 fully OOB)."""
    mask = make_mask(xc)
    reader_m = _StaleRowReader(xc.mm1)
    reader_a = _StaleRowReader(xc.mm2)
    with open(out_path, "w") as f:
        iloc = 0
        for j_y in range(xc.nyl):
            y = int(xc.loc[iloc, 1])
            iy_m = y - xc.npy // 2
            ishft = int(y * xc.astretcha)
            iy_a = y + xc.y_offset + ishft - xc.npy // 2

            d1_row = reader_m.read(iy_m, xc.npy)
            d2_row = reader_a.read(iy_a, xc.npy)

            for i_x in range(xc.nxl):
                x = int(xc.loc[iloc, 0])
                xoff, yoff, xfrac, yfrac, corr = _process_location(
                    xc, x, y, mask, d1_row, d2_row)
                # print_results: xoff_out = xoff/ri − xfrac/ri + x_offset
                #                yoff_out = yoff − yfrac + y_offset + ishft
                xoff_out = (xoff / xc.ri) - (xfrac / xc.ri) + xc.x_offset
                yoff_out = yoff - yfrac + xc.y_offset + ishft
                f.write(f" {x} {xoff_out:6.3f} {y} {yoff_out:6.3f} "
                        f"{corr:6.2f} \n")
                iloc += 1


# ---------------------------------------------------------------- CLI ---
def main() -> int:
    p = argparse.ArgumentParser(add_help=False,
                                description=__doc__.splitlines()[0])
    p.add_argument("master_prm")
    p.add_argument("aligned_prm")
    p.add_argument("-time", action="store_true",
                   help="time-domain correlation (NOT IMPLEMENTED)")
    p.add_argument("-time4", action="store_true",
                   help="time-domain correlation, Gatelli variant (NOT IMPLEMENTED)")
    p.add_argument("-freq", action="store_true", help="frequency-domain (default)")
    p.add_argument("-real", action="store_true",
                   help="read real floats instead of complex shorts (NOT IMPLEMENTED)")
    p.add_argument("-noshift", action="store_true",
                   help="ignore rshift/ashift in PRM")
    p.add_argument("-nointerp", action="store_true",
                   help="disable sub-pixel highres_corr step")
    p.add_argument("-nx", type=int, default=None)
    p.add_argument("-ny", type=int, default=None)
    p.add_argument("-xsearch", type=int, default=None)
    p.add_argument("-ysearch", type=int, default=None)
    p.add_argument("-interp", type=int, default=None)
    p.add_argument("-range_interp", type=int, default=None)
    p.add_argument("-norange", action="store_true")
    p.add_argument("-v", action="store_true")
    p.add_argument("-out", default="freq_xcorr.dat")
    ns = p.parse_args()

    if ns.time or ns.time4:
        print("xcorr_py: -time/-time4 not implemented (freq only)",
              file=sys.stderr); return 2
    if ns.real:
        print("xcorr_py: -real not implemented (complex SLC only)",
              file=sys.stderr); return 2

    xc = XCorr()
    xc.corr_flag = 2
    if ns.noshift: xc.offset_flag = 1
    set_defaults(xc)
    if ns.nx is not None: xc.nxl = ns.nx
    if ns.ny is not None: xc.nyl = ns.ny
    if ns.xsearch is not None: apply_xsearch(xc, ns.xsearch)
    if ns.ysearch is not None: apply_ysearch(xc, ns.ysearch)
    if ns.interp is not None: xc.interp_factor = ns.interp
    if ns.range_interp is not None: xc.ri = ns.range_interp
    if ns.norange: xc.ri = 1
    if ns.nointerp: xc.interp_flag = 0

    handle_prm(xc, ns.master_prm, ns.aligned_prm)
    get_locations(xc)

    t0 = time.time()
    do_correlation(xc, ns.out)
    print(f" elapsed time: {time.time()-t0:.6f}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
