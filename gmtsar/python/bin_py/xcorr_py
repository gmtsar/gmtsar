#! /usr/bin/env python3
"""xcorr_py — Python port of gmtsar's xcorr C binary.

Stub implementation. Phase A: freq-domain cross-correlation via
numpy.fft, single-process. CLI-compatible with the original. Output
file matches the C binary's `freq_xcorr.dat` format.

Status:
  - Freq-domain xcorr: implemented
  - Time-domain (-time): NOT YET
  - Real-input (-real):  NOT YET (only complex SLC supported)
  - Sub-pixel refine:    quadratic interpolation around peak
                         (close to but not bit-exact vs C `highres_corr`)
  - Mask handling:       central-crop instead of full make_mask
  - Per-patch parallelism: NOT YET (Phase C target)

See bin_py/README.md for the full roadmap.

CLI (mirroring xcorr.c):
  xcorr_py master.PRM aligned.PRM [-nx N] [-ny N] [-xsearch X] [-ysearch Y]
"""
from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path

import numpy as np

# Use scipy.fft when available — it accepts `workers=-1` for multi-threaded
# batched FFTs, ~2× faster than np.fft on a 16-core box. Fall back to numpy
# if scipy isn't installed.
try:
    from scipy.fft import fft2 as _fft2, ifft2 as _ifft2
    _SCIPY_FFT_KW = {"workers": -1}
except ImportError:
    from numpy.fft import fft2 as _fft2, ifft2 as _ifft2
    _SCIPY_FFT_KW = {}


# ---------------------------------------------------------------- PRM I/O ---
def read_prm(path: str) -> dict:
    """Parse a gmtsar PRM file into a dict. Keys are stripped strings."""
    prm: dict[str, str] = {}
    with open(path) as f:
        for line in f:
            if "=" not in line:
                continue
            k, _, v = line.partition("=")
            prm[k.strip()] = v.strip()
    return prm


def _f(prm: dict, key: str, default: float = 0.0) -> float:
    """PRM value as float, or default."""
    v = prm.get(key, "").split()
    if not v:
        return default
    try:
        return float(v[0])
    except ValueError:
        return default


def _i(prm: dict, key: str, default: int = 0) -> int:
    """PRM value as int, or default."""
    return int(_f(prm, key, default))


# ------------------------------------------------------------- SLC reader ---
def read_slc(path: str, n_rows: int, n_cols: int) -> np.ndarray:
    """Read a complex SLC file (gmtsar format: pairs of int16, real+imag).

    Returns a 2-D complex64 array of shape (n_rows, n_cols).
    """
    raw = np.fromfile(path, dtype=np.int16)
    expected = n_rows * n_cols * 2
    if raw.size < expected:
        raise ValueError(f"SLC {path} short: have {raw.size} int16, "
                         f"need {expected} ({n_rows}x{n_cols}x2)")
    raw = raw[:expected].reshape(n_rows, n_cols, 2)
    return (raw[..., 0].astype(np.float32) +
            1j * raw[..., 1].astype(np.float32)).astype(np.complex64)


# ------------------------------------------------------- core xcorr block ---
def freq_xcorr_patch(patch_m: np.ndarray, patch_a: np.ndarray,
                     nx_corr: int, ny_corr: int,
                     xsearch: int, ysearch: int,
                     ) -> tuple[float, float, float]:
    """Single-patch freq-domain cross-correlation.

    Mirrors do_freq_corr() + assign_values() in xcorr.c:
      1. Convert complex SLC → real amplitude (|SLC|). Phase has no useful
         signal for image-to-image alignment; amplitude has real
         scene-structure correlation.
      2. Demean both amplitude patches (subtract per-patch mean) — removes
         the DC spike from the FFT and lets the real correlation peak
         emerge.
      3. Apply edge mask to the aligned patch — zero out a border equal
         to (xsearch, ysearch) on each side. Suppresses wrap-around
         contamination in the circular FFT correlation.
      4. FFT-multiply M * conj(A) with (-1)^(i+j) checkerboard sign
         (fftshift trick), inverse FFT → correlation magnitude.
      5. Crop to the central nx_corr × ny_corr search window.
      6. Peak find + parabolic sub-pixel refinement.

    Without steps 1-3, direct complex-SLC correlation is pure noise
    (random SAR phase masks the real shift signal). This was the bug
    in the Phase A first attempt against live data.
    """
    npy, npx = patch_m.shape

    # 1. Complex → amplitude, float32 for FFT speed.
    amp_m = np.abs(patch_m).astype(np.float32)
    amp_a = np.abs(patch_a).astype(np.float32)
    # 2. Demean (per patch).
    amp_m -= amp_m.mean()
    amp_a -= amp_a.mean()
    # 3. Mask the aligned patch's edges (matches make_mask() in xcorr.c).
    if ysearch > 0:
        amp_a[:ysearch, :] = 0
        amp_a[-ysearch:, :] = 0
    if xsearch > 0:
        amp_a[:, :xsearch] = 0
        amp_a[:, -xsearch:] = 0

    # 4. FFT-multiply with checkerboard sign for the fftshift effect.
    F_m = np.fft.fft2(amp_m)
    F_a = np.fft.fft2(amp_a)
    ii, jj = np.meshgrid(np.arange(npy), np.arange(npx), indexing="ij")
    sign = ((-1.0) ** ((ii + jj) % 2)).astype(np.float32)
    F_xc = F_m * np.conj(F_a) * sign
    # Inverse FFT → correlation surface (magnitude only)
    corr_full = np.abs(np.fft.ifft2(F_xc))
    # Crop to the central ny_corr x nx_corr region (where valid)
    y0 = (npy - ny_corr) // 2
    x0 = (npx - nx_corr) // 2
    corr = corr_full[y0:y0 + ny_corr, x0:x0 + nx_corr]
    # Peak location
    peak_y, peak_x = np.unravel_index(int(np.argmax(corr)), corr.shape)
    cmax = float(corr[peak_y, peak_x])
    cave = float(corr.mean())
    # Initial integer offsets (centred on patch midpoint)
    jpeak = peak_x - nx_corr / 2.0
    ipeak = peak_y - ny_corr / 2.0
    # Sub-pixel via parabolic fit around peak (1-D in each axis).
    # This is *close to* but not bit-exact vs C highres_corr.
    def _parabolic_subpix(values: np.ndarray) -> float:
        # values has 3 entries: [center-1, center, center+1].
        # Returns the fractional offset of the parabola vertex from center.
        a, b, c = values
        denom = a - 2 * b + c
        if abs(denom) < 1e-12:
            return 0.0
        return 0.5 * (a - c) / denom
    sub_x = sub_y = 0.0
    if 0 < peak_x < corr.shape[1] - 1:
        sub_x = _parabolic_subpix(corr[peak_y, peak_x - 1:peak_x + 2])
    if 0 < peak_y < corr.shape[0] - 1:
        sub_y = _parabolic_subpix(corr[peak_y - 1:peak_y + 2, peak_x])
    # C code outputs xoff = -jpeak, yoff = -ipeak
    xoff = -(jpeak + sub_x)
    yoff = -(ipeak + sub_y)
    # SNR-ish: peak/mean ratio (matches the cmax/cave the C code computes
    # before the calc_time_corr correction)
    snr = cmax / cave if cave > 0 else 0.0
    return xoff, yoff, snr


def freq_xcorr_batch(patches_m: np.ndarray, patches_a: np.ndarray,
                     nx_corr: int, ny_corr: int,
                     xsearch: int, ysearch: int,
                     ) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    """Vectorized cross-correlation of N patch pairs in one shot.

    Identical algorithm to freq_xcorr_patch (preprocess, FFT, multiply,
    inverse FFT, peak find, parabolic sub-pixel), but operates on a
    batched 3-D array (N, npy, npx) so numpy/scipy's FFT can amortise
    setup across all patches and a multi-threaded FFT backend
    (scipy.fft with workers=-1, or numpy linked against MKL) can use
    all cores.

    Returns three 1-D arrays of length N: xoff, yoff, snr.

    Memory note: peak working set ≈ 2*N*npy*npx*8 bytes (two complex64
    stacks). For RS2 (1000 patches × 512² × 8 B × 2 stacks ≈ 2 GB.
    The caller can chunk if this is too much.
    """
    N, npy, npx = patches_m.shape
    assert patches_a.shape == (N, npy, npx)

    # 1. amplitude (per-patch, vectorized)
    amp_m = np.abs(patches_m).astype(np.float32)
    amp_a = np.abs(patches_a).astype(np.float32)
    # 2. demean per-patch (axes 1,2)
    amp_m -= amp_m.mean(axis=(1, 2), keepdims=True)
    amp_a -= amp_a.mean(axis=(1, 2), keepdims=True)
    # 3. edge mask on aligned (apply ONCE, broadcast across batch)
    if ysearch > 0:
        amp_a[:, :ysearch, :] = 0
        amp_a[:, -ysearch:, :] = 0
    if xsearch > 0:
        amp_a[:, :, :xsearch] = 0
        amp_a[:, :, -xsearch:] = 0
    # 4. Batched FFT (axes -2, -1). scipy.fft.fft2 + workers=-1 is
    # multi-threaded; numpy.fft.fft2 is single-threaded but vectorised.
    F_m = _fft2(amp_m, axes=(-2, -1), **_SCIPY_FFT_KW)
    F_a = _fft2(amp_a, axes=(-2, -1), **_SCIPY_FFT_KW)
    # Checkerboard sign for fftshift, precomputed once, broadcast (1, npy, npx)
    ii, jj = np.meshgrid(np.arange(npy), np.arange(npx), indexing="ij")
    sign = ((-1.0) ** ((ii + jj) % 2)).astype(np.float32)[None, :, :]
    F_xc = F_m * np.conj(F_a) * sign
    corr_full = np.abs(_ifft2(F_xc, axes=(-2, -1), **_SCIPY_FFT_KW))
    # Crop to central ny_corr × nx_corr per patch
    y0 = (npy - ny_corr) // 2
    x0 = (npx - nx_corr) // 2
    corr = corr_full[:, y0:y0 + ny_corr, x0:x0 + nx_corr]

    # 5. Per-patch peak via flat argmax, then unravel
    flat = corr.reshape(N, ny_corr * nx_corr)
    peak_idx = flat.argmax(axis=1)
    peak_y = (peak_idx // nx_corr).astype(np.int32)
    peak_x = (peak_idx %  nx_corr).astype(np.int32)
    cmax = flat[np.arange(N), peak_idx]
    cave = corr.mean(axis=(1, 2))

    # 6. Integer offsets centered on patch midpoint
    jpeak = peak_x.astype(np.float32) - (nx_corr / 2.0)
    ipeak = peak_y.astype(np.float32) - (ny_corr / 2.0)

    # 7. Sub-pixel parabolic refinement (vectorised, with edge-safe mask)
    in_x = (peak_x > 0) & (peak_x < nx_corr - 1)
    in_y = (peak_y > 0) & (peak_y < ny_corr - 1)
    sub_x = np.zeros(N, dtype=np.float32)
    sub_y = np.zeros(N, dtype=np.float32)
    if in_x.any():
        idx = np.where(in_x)[0]
        a = corr[idx, peak_y[idx], peak_x[idx] - 1]
        b = corr[idx, peak_y[idx], peak_x[idx]]
        c = corr[idx, peak_y[idx], peak_x[idx] + 1]
        denom = a - 2 * b + c
        # safe divide: 0 where denom ≈ 0
        mask = np.abs(denom) > 1e-12
        sub_x[idx[mask]] = 0.5 * (a[mask] - c[mask]) / denom[mask]
    if in_y.any():
        idx = np.where(in_y)[0]
        a = corr[idx, peak_y[idx] - 1, peak_x[idx]]
        b = corr[idx, peak_y[idx],     peak_x[idx]]
        c = corr[idx, peak_y[idx] + 1, peak_x[idx]]
        denom = a - 2 * b + c
        mask = np.abs(denom) > 1e-12
        sub_y[idx[mask]] = 0.5 * (a[mask] - c[mask]) / denom[mask]

    # 8. Output: C convention is xoff = -jpeak, yoff = -ipeak
    xoff = -(jpeak + sub_x)
    yoff = -(ipeak + sub_y)
    snr = np.where(cave > 0, cmax / cave, 0.0).astype(np.float32)
    return xoff, yoff, snr


# ----------------------------------------------------------------- driver ---
def run_xcorr(master_prm: str, aligned_prm: str,
              nx: int = 20, ny: int = 50,
              xsearch: int = 128, ysearch: int = 128,
              outfile: str = "freq_xcorr.dat") -> int:
    pm = read_prm(master_prm)
    pa = read_prm(aligned_prm)

    m_nx = _i(pm, "num_rng_bins")
    m_ny = _i(pm, "num_valid_az") * max(_i(pm, "num_patches"), 1)
    a_nx = _i(pa, "num_rng_bins")
    a_ny = _i(pa, "num_valid_az") * max(_i(pa, "num_patches"), 1)
    if m_nx == 0 or m_ny == 0:
        raise SystemExit(f"xcorr_py: master.PRM missing num_rng_bins / num_valid_az ({master_prm})")

    # Patch + correlation sizes — must match C parse_xcorr_input.c:
    # -xsearch X overrides: xsearch=X, nx_corr=2*X, npx=nx_corr+2*xsearch=4X.
    nx_corr = 2 * xsearch
    ny_corr = 2 * ysearch
    npx = nx_corr + 2 * xsearch     # = 4 * xsearch
    npy = ny_corr + 2 * ysearch

    # Location grid — match C get_locations.c exactly so (x,y) align.
    # x = npx + i*x_inc for i in [2..nxl+1];   y = npy + j*y_inc for j in [1..nyl]
    x_inc = (m_nx - 2 * (xsearch + nx_corr)) // (nx + 3)
    y_inc = (m_ny - 2 * (ysearch + ny_corr)) // (ny + 1)
    if x_inc <= 0 or y_inc <= 0:
        raise SystemExit(f"xcorr_py: image too small "
                         f"(m={m_nx}x{m_ny}, patch {npx}x{npy}, search {xsearch}x{ysearch})")

    print(f"xcorr_py: master {m_nx}x{m_ny}, patch {npx}x{npy}, "
          f"grid {nx}x{ny}, search {xsearch}x{ysearch}, "
          f"x_inc={x_inc} y_inc={y_inc}")

    # Load SLCs (memory: a SLC can be ~GB; stream patches in production,
    # but for the stub we load the whole thing for simplicity)
    m_slc_path = pm.get("SLC_file", "").split()[0]
    a_slc_path = pa.get("SLC_file", "").split()[0]
    # Resolve relative to PRM dir
    base = os.path.dirname(master_prm)
    if not os.path.isabs(m_slc_path):
        m_slc_path = os.path.join(base, m_slc_path)
    if not os.path.isabs(a_slc_path):
        a_slc_path = os.path.join(base, a_slc_path)

    m_slc = read_slc(m_slc_path, m_ny, m_nx)
    a_slc = read_slc(a_slc_path, a_ny, a_nx)

    # Initial offsets — the C code defaults x_offset/y_offset to 0 and does
    # NOT read rshift/ashift from the PRM. xcorr's purpose is to MEASURE
    # the offset; consumers (fitoffset, resamp) will write rshift/ashift
    # into the PRM downstream. If a future caller needs to seed an initial
    # guess (e.g. for very large offsets), add a CLI flag.
    x_offset = 0
    y_offset = 0

    # First pass: enumerate every patch location and pre-stack the patch
    # arrays so we can do ONE batched FFT over all of them.
    locs = []
    patches_m_list = []
    patches_a_list = []
    for j in range(1, ny + 1):
        cy = npy + j * y_inc
        y0 = cy - npy // 2
        if y0 < 0 or y0 + npy > m_ny:
            continue
        for i in range(2, nx + 2):
            cx = npx + i * x_inc
            x0 = cx - npx // 2
            if x0 < 0 or x0 + npx > m_nx:
                continue
            ax0 = x0 + x_offset
            ay0 = y0 + y_offset
            if (ax0 < 0 or ay0 < 0
                or ax0 + npx > a_nx or ay0 + npy > a_ny):
                continue
            locs.append((cx, cy))
            patches_m_list.append(m_slc[y0:y0 + npy, x0:x0 + npx])
            patches_a_list.append(a_slc[ay0:ay0 + npy, ax0:ax0 + npx])

    if not locs:
        raise SystemExit("xcorr_py: no valid patch locations")

    # Vectorised batched FFT path. Memory peak ~ 2 * N * npy * npx * 8 bytes
    # (two complex64 stacks). For RS2 (N=1000, 512x512) that's ~2 GB; for
    # heavier cases the caller can chunk by reducing nx/ny.
    patches_m_arr = np.stack(patches_m_list)
    patches_a_arr = np.stack(patches_a_list)
    print(f"xcorr_py: vectorised batch size {len(locs)} "
          f"({patches_m_arr.nbytes * 2 / 1e9:.2f} GB working set)")
    xoffs, yoffs, snrs = freq_xcorr_batch(patches_m_arr, patches_a_arr,
                                          nx_corr, ny_corr,
                                          xsearch, ysearch)

    rows = []
    for k, (cx, cy) in enumerate(locs):
        xoff_total = float(xoffs[k]) + x_offset
        yoff_total = float(yoffs[k]) + y_offset
        rows.append((cx, xoff_total, cy, yoff_total, float(snrs[k])))

    with open(outfile, "w") as f:
        for cx, xoff, cy, yoff, snr in rows:
            f.write(f" {cx} {xoff:6.3f} {cy} {yoff:6.3f} {snr:6.2f} \n")
    print(f"xcorr_py: wrote {len(rows)} rows → {outfile}")
    return 0


# ------------------------------------------------------------------ CLI ----
def main() -> int:
    ap = argparse.ArgumentParser(description="xcorr_py — Python port of gmtsar xcorr (stub)")
    ap.add_argument("master_prm")
    ap.add_argument("aligned_prm")
    ap.add_argument("-nx", type=int, default=20)
    ap.add_argument("-ny", type=int, default=50)
    ap.add_argument("-xsearch", type=int, default=128)
    ap.add_argument("-ysearch", type=int, default=128)
    ap.add_argument("-o", "--output", default="freq_xcorr.dat")
    # Accept-but-ignore flags for CLI compatibility
    ap.add_argument("-freq", action="store_true", help="(default; alias)")
    ap.add_argument("-time", action="store_true", help="(NOT IMPLEMENTED — will error)")
    ap.add_argument("-real", action="store_true", help="(NOT IMPLEMENTED — will error)")
    args = ap.parse_args()

    if args.time:
        print("xcorr_py: -time mode not yet implemented (Phase A stub)", file=sys.stderr)
        return 2
    if args.real:
        print("xcorr_py: -real input not yet implemented (Phase A stub)", file=sys.stderr)
        return 2

    return run_xcorr(args.master_prm, args.aligned_prm,
                     nx=args.nx, ny=args.ny,
                     xsearch=args.xsearch, ysearch=args.ysearch,
                     outfile=args.output)


if __name__ == "__main__":
    sys.exit(main())
