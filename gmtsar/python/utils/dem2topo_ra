class _PhaseTimer:
    """start()/stop() wrapper around the `phase()` context manager.

    Used where a phase spans an if/elif block we don't want to
    re-indent (the mode==0 vs mode==1 surface branches below).
    """
    def __init__(self, name):
        self._cm = _dem2topo_phase(name)

    def start(self):
        self._cm.__enter__()
        return self

    def stop(self):
        self._cm.__exit__(None, None, None)

