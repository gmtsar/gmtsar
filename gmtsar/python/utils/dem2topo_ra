# Mira (2026-05-22): in-memory chain between adjacent in-process ops.
# When GMTSAR_DEM2TOPO_INMEM_CHAIN=1 (default ON since v2.1.28), the
# in-process `surface` step does NOT write its `pixel.grd` to disk and
# instead stashes (grid, x_coord, y_coord, node_offset, history) in this
# module-level carrier keyed by the would-be output path. The
# subsequent in-process `_grdmath_flipud` step picks it up and skips
# the intermediate `pixel.grd` read/write entirely; the only disk
# write in the chain is the final `topo_ra.grd`.
#
# Byte-identity is preserved: numpy.flipud is deterministic, the
# coord vectors and node_offset are identical to what the disk
# round-trip would yield, and `_write_gmt_grd` is the same writer.
#
# GMTSAR_SURFACE_INPROC defaults to "0"/OFF for this module's pixel.grd
# call.  The same env var defaults to "1"/ON in proj_ra2ll_lib.py's
# _ensure_raln_ralt (flipped there in v2.1.27): that flip is for the
# raln/ralt surface call which does NOT use pixel_reg and IS byte-identical
# to gmt surface.  This module's pixel.grd call uses pixel_reg + a large
# gcd-hierarchy expansion; gmt_surface_py's GS-SOR solver diverges from
# gmt surface on real terrain at that scale (Mira #72).
#
# History
# -------
# * v2.1.27: INPROC=1 default set for proj_ra2ll_lib.py's surface call
#   only (raln/ralt, non-pixel_reg, verified byte-identical).
# * v2.1.28: RS2_SLC_Hawaii "byte-identical" smoke run for this module --
#   but the subprocess fallback (try/except) was silently doing the work;
#   gmt_surface_py raised NotImplementedError at pixel_reg crop-back (Mira
#   #68), got caught, subprocess ran.  Incorrectly logged as "gmt_surface_py
#   is bit-identical".
# * v2.1.32: default flipped to "1" for this module based on the wrong
#   RS2 smoke.
# * v2.2.0 pre-release: CSK_SLC_Italy phasefilt.grd complex-rms = 0.2298
#   (threshold 0.15).  Root-caused to gmt_surface_py producing topo_ra.grd
#   rms=0.46m vs gmt surface on 5595x5367 px terrain (Mira #72).
#   Default reverted to "0".  Do not re-flip until Mira #72 is closed and
#   CSK_SLC_Italy parity passes with INPROC=1.
def _chain_enabled() -> bool:
    return (os.environ.get("GMTSAR_DEM2TOPO_INMEM_CHAIN", "1") == "1"
            and _HAVE_GMT_GRD_IO)


# Carrier dict: {out_path: {grid, x_coord, y_coord, node_offset, history}}
# Per-process global (dem2topo_ra is a one-shot CLI; no thread-safety
# requirement). Cleared by `_grdmath_flipud` after consumption.
_PENDING_INMEM_GRID: dict = {}


def _gmtconvert_pipe_to_temprat(trans_dat: str, region: str, rng_step: int,
                                az_step: int, V: str, out_path: str) -> None:
    """Replacement for the bash pipe:

        gmt gmtconvert <trans_dat> -o0,1,2 -bi5d -bo3d \
          | gmt blockmedian -R<region> -I<rng_step>/<az_step> -bi3d -bo3d -r <V>
          > <out_path>

    Three execution paths, in priority order:
      1. inproc=on + blockmedian_py (GMTSAR_BLOCKMEDIAN_PY=1, default since
         v2.1.30): full in-process memmap -> col-select -> blockmedian ->
         bytes-out, no subprocess at all. Byte-parity-tested (13/13) and,
         after the Mira #67 n==1 fast path, FASTER than `gmt blockmedian`
         at dem2topo_ra's 1-pt/bin density. See the import-site note.
      2. inproc=on + only gmtconvert_select_cols_bin: numpy col-select
         then `gmt blockmedian` subprocess (Mira #19 path). Used when
         GMTSAR_BLOCKMEDIAN_PY=0.
      3. inproc=off (GMTSAR_GMT_INPROC=0): pure `gmt | gmt` pipe.

    Paths 2 and 3 are the production fast/fallback. Path 1 is reserved
    for a future bin-density gate. All three are byte-equivalent on the
    temp.rat output (verified per
    bin_py/tests/test_gmt_blockmedian_py.py::TestParityRealData on 9M
    rows of real RS2 trans.dat, plus the in-line parity check in the
    Mira #30 commit).
    """
    use_inproc = _HAVE_GMT_INPROC and _inproc_enabled()
    use_blockmedian_py = (use_inproc and _HAVE_GMT_BLOCKMEDIAN_PY
                           and os.environ.get("GMTSAR_BLOCKMEDIAN_PY", "1") == "1")
    if use_blockmedian_py:
        # Full in-process: memmap → col-select → blockmedian → bytes-out.
        # `region` is "xmin/xmax/ymin/ymax" (`set_region_string` format).
        try:
            rg = [float(s) for s in str(region).split("/")]
        except ValueError as exc:
            raise ValueError(
                f"_gmtconvert_pipe_to_temprat: bad region '{region}' "
                f"(want 'xmin/xmax/ymin/ymax'): {exc}")
        if len(rg) != 4:
            raise ValueError(
                f"_gmtconvert_pipe_to_temprat: region must have 4 numbers, "
                f"got {rg}")
        # Memmap the 5-double trans.dat and slice cols [0,1,2] to a
        # contiguous (N,3) float64 array (no temp file needed).
        sz = os.path.getsize(trans_dat)
        if sz % (5 * 8) != 0:
            raise ValueError(
                f"_gmtconvert_pipe_to_temprat: trans.dat size {sz} not "
                f"multiple of 5*8")
        n_rows = sz // (5 * 8)
        in_mm = _np.memmap(trans_dat, dtype=_np.float64, mode="r",
                           shape=(n_rows, 5))
        _advise_sequential(in_mm)  # Mira #37: avoid NFS per-page fault storms
        xyz = _np.ascontiguousarray(in_mm[:, :3])
        # blockmedian returns (M, 3) float64; tobytes is the 3-double
        # binary stream `gmt blockmedian -bo3d` writes.
        out = _py_blockmedian(xyz,
                              region=(rg[0], rg[1], rg[2], rg[3]),
                              inc=(float(rng_step), float(az_step)),
                              pixel_reg=True)
        out.astype(_np.float64, copy=False).tofile(out_path)
        return
    if use_inproc:
        # Slice cols 0,1,2 from the 5-double trans.dat → 3-double tmp file,
        # then pipe to blockmedian directly. ~0.5-1.0 s saved per call.
        tmp_xyz = out_path + ".xyz3.bin"
        gmtconvert_select_cols_bin(trans_dat, 5, [0, 1, 2], tmp_xyz)
        cmd = (
            f"gmt blockmedian {tmp_xyz} -R{region} -I{rng_step}/{az_step} "
            f"-bi3d -bo3d -r {V} > {out_path}"
        )
        run(cmd)
        try:
            os.remove(tmp_xyz)
        except OSError:
            pass
    else:
        cmd = (
            f"gmt gmtconvert {trans_dat} -o0,1,2 -bi5d -bo3d | "
            f"gmt blockmedian -R{region} -I{rng_step}/{az_step} "
            f"-bi3d -bo3d -r {V} > {out_path}"
        )
        run(cmd)


def _grdmath_flipud(src_grd: str, dst_grd: str) -> None:
    """Replacement for `gmt grdmath <src> FLIPUD = <dst>`.

    Reads the source grid via netCDF4, flips along the y axis, writes
    a GMT-compatible netCDF via utils/gmt_grd_io.write_gmt_grd. The
    writer-flavor output is bit-readable by GMT 6.4.0 and by gmtsar's
    `offset_topo`, `gmt grdinfo`, `gmt grdimage` — verified by the
    16-test suite in bin_py/tests/test_gmt_grd_io.py.

    Disable by setting GMTSAR_GMT_INPROC=0 to fall back to the gmt
    subprocess (debug-only A/B path).

    Skipped if either:
      - GMTSAR_GMT_INPROC=0 (debug fallback)
      - gmt_grd_io / netCDF4 not importable (fail-soft to subprocess)
    """
    use_inproc = _HAVE_GMT_GRD_IO and _inproc_enabled()
    if use_inproc:
        try:
            # Chain fast-path: upstream `_surface_inproc` may have stashed
            # an in-memory grid keyed by src_grd. Consume it directly and
            # skip the .grd read entirely (NFS round-trip elimination).
            stash = _PENDING_INMEM_GRID.pop(src_grd, None)
            if stash is not None:
                data = stash["grid"]
                x = stash["x_coord"]
                y = stash["y_coord"]
                node_off = int(stash.get("node_offset", 1))
                geographic = bool(stash.get("geographic", False))
                upstream_hist = stash.get("history", "")
                flipped = _np.flipud(data)
                _write_gmt_grd(
                    dst_grd, flipped, x, y,
                    node_offset=node_off,
                    geographic=geographic,
                    history=(f"{upstream_hist} | "
                             f"gmt grdmath {src_grd} FLIPUD = {dst_grd} "
                             "[gmt_grd_io in-process, chained]"),
                )
                return
            data, x, y, info = _read_gmt_grd(src_grd)
            flipped = _np.flipud(data)
            # Preserve node_offset (pixel vs gridline) and geographic
            # flags. `gmt surface ... -r` produces pixel-registered grids,
            # so node_offset will typically be 1.
            _write_gmt_grd(
                dst_grd, flipped, x, y,
                node_offset=int(info.get("node_offset", 0)),
                geographic=bool(info.get("geographic", False)),
                history=f"gmt grdmath {src_grd} FLIPUD = {dst_grd} "
                        "[gmt_grd_io in-process]",
            )
            return
        except Exception as exc:
            print(f"DEM2TOPO_RA: WARN: in-process FLIPUD failed ({exc!r}); "
                  "falling back to gmt subprocess.", file=sys.stderr)
            # If we'd stashed an in-mem grid but consumption failed, the
            # disk file does not exist — flush the stash so we don't
            # leave a dangling reference and force the subprocess to
            # read a nonexistent file.
            stash = _PENDING_INMEM_GRID.pop(src_grd, None)
            if stash is not None:
                # Emergency: write the stashed grid out so the subprocess
                # path can succeed. This is a hard-failure recovery — we
                # still want to honor the legacy behavior cleanly.
                try:
                    _write_gmt_grd(
                        src_grd, stash["grid"], stash["x_coord"],
                        stash["y_coord"],
                        node_offset=int(stash.get("node_offset", 1)),
                        geographic=bool(stash.get("geographic", False)),
                        history=stash.get("history", ""),
                    )
                except Exception as exc2:
                    print(f"DEM2TOPO_RA: ERROR: stash-flush failed ({exc2!r})",
                          file=sys.stderr)
                    raise
    # Fallback: classic gmt subprocess. If we still have a stash, flush
    # it to disk first so the subprocess sees a real file. (This case
    # happens when GMTSAR_GMT_INPROC=0 explicitly disables the in-proc
    # path AFTER `_surface_inproc` ran with the chain on — unusual but
    # possible.)
    stash = _PENDING_INMEM_GRID.pop(src_grd, None)
    if stash is not None:
        _write_gmt_grd(
            src_grd, stash["grid"], stash["x_coord"], stash["y_coord"],
            node_offset=int(stash.get("node_offset", 1)),
            geographic=bool(stash.get("geographic", False)),
            history=stash.get("history", ""),
        )
    run(f'gmt grdmath {src_grd} FLIPUD = {dst_grd}')


# Mira #41 (2026-05-22): in-process `gmt surface` for dem2topo_ra
# (the biggest remaining gmt subprocess in the pipeline; per-case wall
# time impact 25-50 s).  Gated by GMTSAR_SURFACE_INPROC=1 (default off
# pending pre-flight smoke + fast clearance).  The Numba-accelerated
# gmt_surface_py module (utils/gmt_surface_py.py) supports:
#  - Anisotropic cells via the alpha=dy/dx prefactors (Mira #33)
#  - FMG nested iteration for fast convergence (Mira #21)
#  - Briggs sub-cell constraints (GMT_SURFACE_PY_BRIGGS=1; Mira #41)
#  - Native pixel registration (pixel_reg=True; Mira #41)
def _surface_inproc(temp_rat: str, region_str: str, rng_step: int,
                    az_step: int, tension: float, out_path: str,
                    chainable: bool = False) -> None:
    """In-process replacement for
        gmt surface <temp.rat> -R<region> -I<rng>/<az> -bi3d -T<tension>
                    -N1000 -G<out> -r

    Reads temp.rat (binary 3-double rows: x, y, z), invokes
    gmt_surface_py with pixel registration to match `gmt surface ... -r`,
    and writes the result via gmt_grd_io.write_gmt_grd (canonical
    GMT-compatible netCDF flavor).

    Falls back loudly (raises) on failure — the caller may then catch
    and degrade to the gmt subprocess; that policy is decided at the
    call site, not silently in this helper.
    """
    from gmt_surface_py import gmt_surface_py
    # Parse region "x0/x1/y0/y1"
    parts = region_str.split("/")
    if len(parts) != 4:
        raise ValueError(f"bad region '{region_str}' for in-proc surface")
    x0, x1, y0, y1 = (float(p) for p in parts)
    data = _np.fromfile(temp_rat, dtype=_np.float64)
    if data.size % 3 != 0:
        raise ValueError(f"{temp_rat}: size {data.size} not divisible by 3 doubles")
    data = data.reshape(-1, 3)
    x = data[:, 0]; y = data[:, 1]; z = data[:, 2]
    grid = gmt_surface_py(
        x, y, z,
        region=(x0, x1, y0, y1),
        inc=(float(rng_step), float(az_step)),
        tension=float(tension),
        # omega=1.4 matches surface.c:135 SURFACE_OVERRELAXATION; max_iter=1000
        # matches the C pipeline's `-N1000`.  The prior omega=0.5 (Mira #41, no
        # documented justification) was severe UNDER-relaxation: it both crawled
        # on large grids (ENVI surface 2261s) AND returned unconverged/divergent
        # results within the iter budget (S1_Ridgecrest H_res 77M-cell grid drifted
        # 41m from `gmt surface` -> phasefilt parity failure).  Matching C's omega
        # AND max_iter makes the GS-SOR iterate identically to C even when
        # iteration-bounded on heterogeneous terrain (Mira perf audit 2026-06-13).
        max_iter=1000, tol=1e-4,
        omega=1.4,
        use_multigrid=True,
        pixel_reg=True,
    )
    ny, nx = grid.shape
    x_coord = x0 + float(rng_step) / 2.0 + _np.arange(nx) * float(rng_step)
    y_coord = y0 + float(az_step) / 2.0 + _np.arange(ny) * float(az_step)
    history = (f"gmt_surface_py (-T{tension}) "
               f"-I{rng_step}/{az_step} -r")
    # In-memory chain: stash the grid for the downstream FLIPUD step
    # instead of writing pixel.grd to disk. The downstream
    # `_grdmath_flipud` consumes the stash, flips, and writes only
    # `topo_ra.grd` — eliminating the intermediate `pixel.grd`
    # write+read round-trip (5-10 s on NFS).
    if chainable and _chain_enabled():
        _PENDING_INMEM_GRID[out_path] = {
            "grid": grid,
            "x_coord": x_coord,
            "y_coord": y_coord,
            "node_offset": 1,
            "geographic": False,
            "history": history,
        }
        return
    _write_gmt_grd(out_path, grid, x_coord, y_coord, node_offset=1,
                   history=history)


def _surface_or_run(args_str: str, temp_rat: str, region_str: str,
                    rng_step: int, az_step: int, tension: float,
                    out_path: str, chainable: bool = False) -> None:
    """Dispatch the surface call.

    Default OFF (GMTSAR_SURFACE_INPROC=0, reverted from v2.1.32 which
    incorrectly defaulted to "1"): gmt_surface_py's iterative GS-SOR
    solver diverges from gmt surface on real terrain at CSK scale
    (5595x5367 px, B=565m) producing topo_ra.grd rms=0.46m vs reference
    — sufficient to cause >2π phase wrapping and phasefilt complex-rms
    0.23 (threshold 0.15).  Root cause: Mira #72 (iterative solution
    diverges even though convergence threshold and iteration count match
    gmt exactly).  Set GMTSAR_SURFACE_INPROC=1 to opt-in to gmt_surface_py
    (only safe once Mira #72 is closed).

    If ``chainable=True`` AND ``GMTSAR_DEM2TOPO_INMEM_CHAIN=1``, the
    surface result is stashed in-memory for the downstream FLIPUD step
    instead of being written to ``out_path``. The caller MUST guarantee
    that no other process or subprocess will read ``out_path`` between
    this call and the next ``_grdmath_flipud(out_path, ...)`` — i.e.
    only set ``chainable=True`` on the direct surface → FLIPUD path
    (mode=0, RR empty).

    No try/except fallback to the subprocess (Rule 12): a prior version
    caught any exception from ``_surface_inproc`` and re-ran via ``run()``.
    For RS2_SLC_Hawaii's pixel.grd (region 0/3416/0/5744, inc 2/4,
    pixel_reg) this masked a real NotImplementedError in gmt_surface_py's
    gcd-hierarchy + pixel_reg crop-back (Mira #68 known limitation): the
    in-process path ran the FULL multigrid solve (~26s), threw at the
    final crop step, and the fallback silently redid the work via
    subprocess (~12s) -- 38s total reported as "gmt_surface_py is 3.2x
    slower" when in fact gmt_surface_py never produced output at all.
    Fixed 2026-06-13; default was incorrectly flipped to ON same day
    (reverted — see Mira #72 and CSK_SLC_Italy parity failure above).
    """
    inproc = (os.environ.get("GMTSAR_SURFACE_INPROC", "0") == "1"
              and _HAVE_GMT_GRD_IO)
    if not inproc:
        run(args_str)
        return
    _surface_inproc(temp_rat, region_str, rng_step, az_step,
                    tension, out_path, chainable=chainable)


def dem2topo_ra():

    def Error_Message():
        print( " ")
        print( "Usage: dem2topo_ra master.PRM dem.grd [interpolation_approach]")  
        print( " ")
        print( " NOTE: interpolation approach default is 0: surface with tension.")
        print( "        set to 1 for gmt triangulate.")
        print( " ")
        
    print('DEM2TOPO_RA - START ... ...')
    
    n = len(sys.argv)
    if n!=4 and n!=3 :
        print('FILTER: Wrong # of input arguments; # should be 3 or 2 ... ...')
        Error_Message()
    
    print(' ')
    print("DEM2TOPO_RA: check if ~/.quiet file exists ... ...")
    if check_file_report('~/.quiet') == True:
        V = ''
    else:
        V = '-V'
    print('DEM2TOPO_RA: flag V is ', V)
    scale = '-JX7i'
    
    print('DEM2TOPO_RA - START ... ...')
    print(' ')
    tension = 0.1
    mode    = 0
    if n == 4:
        mode = int(sys.argv[3])
    print('DEM2TOPO_RA: tension is ', tension)
    print('DEM2TOPO_RA: interpolation approach mode is ', mode)    
    
    print(' ')
    print('DEM2TOPO_RA: Mosaic topo data ... ...')
    print('DEM2TOPO_RA: get bounds in radar coordinates ... ...')
    
    XMAX   = int(grep_value(sys.argv[1],'num_rng_bins',3))
    yvalid = int(grep_value(sys.argv[1],'num_valid_az',3))
    num_patch = int(grep_value(sys.argv[1],'num_patches',3))
    YMAX   = yvalid*num_patch
    SC     = int(grep_value(sys.argv[1],'SC_identity',3))
    # original csh command: set PRF = `grep PRF *.PRM | awk 'NR == 1 {printf("%d", $3)}'`
    # set PRF to be the value of first encounter of PRF in *.PRM files. 
    pwd = os.getcwd()
    all_files = os.listdir(pwd)
    for filename in all_files:
        if os.path.splitext(filename)[1] == '.PRM':
            PRF = float(grep_value(filename, 'PRF', 3))
            
    region = "0/"+str(XMAX)+"/0/"+str(YMAX)
    
    print('DEM2TOPO_RA: XMAX is ', XMAX)
    print('DEM2TOPO_RA: yvalid is ', yvalid)
    print('DEM2TOPO_RA: num_patch is ', num_patch)
    print('DEM2TOPO_RA: YMAX is ', YMAX)
    print('DEM2TOPO_RA: SC is ', SC)
    print('DEM2TOPO_RA: PRF is ', PRF)
    print('DEM2TOPO_RA: region is ', region)
    
    print(' ')
    print('DEM2TOPO_RA: working over ',region, ' ... ...')
    print('DEM2TOPO_RA: look for range sampling rate ... ...')
    
    # original csh command: set rng_samp_rate = `grep rng_samp_rate $1 | awk 'NR == 1 {printf("%d", $3)}'`
    rng_samp_rate  = float(grep_value(sys.argv[1],'rng_samp_rate',3))
    print('DEM2TOPO_RA: rng_samp_rate is ', rng_samp_rate)
    print(' ')
    print('DEM2TOPO_RA: set the range of simulation in units of image range pixel size ... ...')
    if rng_samp_rate>0 and rng_samp_rate<25000000:
        rng = 1
    elif (rng_samp_rate>=25000000 and rng_samp_rate<72000000) or SC == 7:
        rng = 2
    elif rng_samp_rate>=72000000:
        rng = 4
    else:
        print('DEM2TOPO_RA: ERROR: range sampling rate out of bounds ... ...')
    
    print('DEM2TOPO_RA: range decimation rng is ', rng)
    # SAT_llt2rat_py wire-in (2026-05-20, after Mira #2 goldop closure):
    # bit-identical to C SAT_llt2rat on RS2 Hawaii DEM (azi_pix max|d|=0
    # on all 978882 rows, sub-Angstrom range_pix residual). 3.5× slower
    # than C (precise=0: 32 s vs 9 s) but the end-to-end pipe stays
    # competitive because blockmedian/surface dominate the runtime.
    #
    # Mira #4 (2026-05-21): MUST use the SAME ASCII `--FORMAT_FLOAT_OUT=%lf`
    # input pipe that dem2topo_ra.csh uses. The earlier `-bi3d` fast path
    # fed SAT_llt2rat_py full-precision float64 lon/lat/h that the C
    # SAT_llt2rat never saw — quantization-free inputs push goldop's
    # time-bracket search into different bins on ~99% of rows (max|d|
    # azi_pix = 2 px on ALOS_haiti), corrupting topo_ra → topo_shift →
    # phase → unwrap → los by ~0.077 m / 0.07 rad / 1.5 mm RMS.
    # ASCII %lf path gives sub-ULP parity to C on lon/lat (max|d|=0),
    # azi_pix (max|d|=3.6e-12 px), and height (1.9e-9 m). See Mira
    # AUDIT note in gmtsar/python/AUDIT.md (ALOS_haiti los_ll fix).
    # See gmtsar/python/AUDIT_SAT_llt2rat_py.md for the 9 sub-ULP bugs
    # Mira #2 fixed to close parity.
    with _dem2topo_phase("grd2xyz_SAT_llt2rat"):
        if SC == 10 or SC == 11:
            run('gmt grd2xyz --FORMAT_FLOAT_OUT=%lf '+sys.argv[2]+' -s | SAT_llt2rat_py '+sys.argv[1]+' 1 -bod > trans.dat')
        else:
            run('gmt grd2xyz --FORMAT_FLOAT_OUT=%lf '+sys.argv[2]+' -s | SAT_llt2rat_py '+sys.argv[1]+' 0 -bod > trans.dat')
    
    print(' ')
    print('DEM2TOPO_RA: use an azimuth spacing of 2 for low PRF data such as S1 TOPS ... ...')
    
    if PRF<1000:
        print('DEM2TOPO_RA: if PRF<1000, then ... ...')
        # Mira (Tier-1 gmt subprocess kill): gmtconvert -o0,1,2 -bi5d -bo3d
        # now happens in-process via numpy memmap column slice
        # (utils/gmt_inproc.py). Bit-id with gmt — see
        # bin_py/tests/test_gmt_inproc.py::TestGmtconvertSelectCols.
        with _dem2topo_phase("gmtconvert_to_temprat"):
            _gmtconvert_pipe_to_temprat("trans.dat", str(region), int(rng), 2,
                                        str(V), "temp.rat")
        _pt_surface = _PhaseTimer("surface").start()
        if mode == 0:
            run("gmt surface temp.rat -R"+str(region)+" -I"+str(rng)+"/2 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r -Q >& tmp")
            
            print('DEM2TOPO_RA: ?? is it possible that file tmp is not created? ... ')
            if check_file_report('tmp') == True:
                # Defining RR
                # Original cmd: set RR = `grep Hint tmp | head -1 | awk '{for(i=1;i<=NF;i++) print $i}' | grep /`
                with open('tmp','r') as f:
                # Read the content of the file 'tmp'
                    content = f.read()
                # Split the content into lines
                lines = content.split('\n')

                # Find the first line containing 'Hint'
                hint_line = next((line for line in lines if 'Hint' in line), None)

                # If a 'Hint' line is found, split it into words and filter those containing '/'
                if hint_line:
                    words = hint_line.split()
                    RR = [word for word in words if '/' in word]
                else:
                    RR = []
            else:
                RR=[]
            # Print the result
            print('DEM2TOPO_RA: RR is ', RR)
            
            if RR == []: # if RR is empty or unset
                # Chainable: surface → FLIPUD has no intermediate consumer
                # of pixel.grd, so in-mem stash is safe here.
                _surface_or_run(
                    "gmt surface temp.rat -R"+str(region)+" -I"+str(rng)+"/2 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r "+str(V),
                    "temp.rat", str(region), int(rng), 2, float(tension), "pixel.grd",
                    chainable=True)
            else:
                # RR is like ['-R0/800/0/1600']; strip the leading -R for our parser.
                rr_str = str(RR[0]) if isinstance(RR, list) and RR else str(RR)
                _surface_or_run(
                    "gmt surface temp.rat "+str(RR)+" -I"+str(rng)+"/2 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r "+str(V),
                    "temp.rat", rr_str.replace("-R", "").strip(),
                    int(rng), 2, float(tension), "pixel.grd")
                # Mira (2026-05-22): in-process grdcut. Bit-id to gmt C +
                # ~3.3× faster on real DEM. GMTSAR_GRDCUT_PY=0 → subprocess.
                if _HAVE_GRDCUT_PY:
                    _grdcut_file("pixel.grd", "tmp.grd", region=str(region))
                else:
                    run("gmt grdcut pixel.grd -R"+str(region)+" -Gtmp.grd")
                file_shuttle('tmp.grd','pixel.grd','mv')
        elif mode == 1:
            rng2 = rng*8
            print('DEM2TOPO_RA: mode == 1 and rng2 is ', rng2)
            run("gmt triangulate temp.rat -R"+str(region)+" -I"+str(rng)+"/2 -bi3d -Gtopo_ra_tmp.grd -r "+str(V))
            run("gmt blockmean temp.rat -R"+str(region)+" -I"+str(rng2)+"/16 -bi3d -bo3d -r > mean.rat")
            _surface_or_run(
                "gmt surface mean.rat -R"+str(region)+" -I"+str(rng2)+"/16 -bi3d -T0.1 -N1000 -Gcoarse.grd -r",
                "mean.rat", str(region), int(rng2), 16, 0.1, "coarse.grd")
            # Mira (2026-05-22): in-process gmt_grdfill_py (-Ag).
            # GMTSAR_GRDFILL_PY=0 → subprocess.
            _grdfill_dispatch("topo_ra_tmp.grd", "pixel.grd", "coarse.grd")
            delete('topo_ra_tmp.grd')
            delete('coarse.grd')
            delete('mean.rat')
        _pt_surface.stop()
    else:
        print('DEM2TOPO_RA: if PRF>=1000, then ... ...')
        # Mira (Tier-1 gmt subprocess kill): same as PRF<1000 branch.
        with _dem2topo_phase("gmtconvert_to_temprat"):
            _gmtconvert_pipe_to_temprat("trans.dat", str(region), int(rng), 4,
                                        str(V), "temp.rat")
        _pt_surface = _PhaseTimer("surface").start()
        if mode == 0:
            run("gmt surface temp.rat -R"+str(region)+" -I"+str(rng)+"/4 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r -Q >& tmp")
            
            print('DEM2TOPO_RA: ?? is it possible that file tmp is not created? ... ')
            if check_file_report('tmp')==True:
                # Defining RR
                # Original cmd: set RR = `grep Hint tmp | head -1 | awk '{for(i=1;i<=NF;i++) print $i}' | grep /`
                with open('tmp','r') as f:
                # Read the content of the file 'tmp'
                    content = f.read()
                # Split the content into lines
                lines = content.split('\n')

                # Find the first line containing 'Hint'
                hint_line = next((line for line in lines if 'Hint' in line), None)

                # If a 'Hint' line is found, split it into words and filter those containing '/'
                if hint_line:
                    words = hint_line.split()
                    RR = [word for word in words if '/' in word]
                else:
                    RR = []
            else:
                RR = []
                
            # Print the result
            print('DEM2TOPO_RA: RR is ', RR)
            
            if RR == []: # if RR is empty or unset
                # Chainable: see PRF<1000 branch above.
                _surface_or_run(
                    "gmt surface temp.rat -R"+str(region)+" -I"+str(rng)+"/4 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r "+str(V),
                    "temp.rat", str(region), int(rng), 4, float(tension), "pixel.grd",
                    chainable=True)
            else:
                rr_str = str(RR[0]) if isinstance(RR, list) and RR else str(RR)
                _surface_or_run(
                    "gmt surface temp.rat "+str(RR)+" -I"+str(rng)+"/4 -bi3d -T"+str(tension)+" -N1000 -Gpixel.grd -r "+str(V),
                    "temp.rat", rr_str.replace("-R", "").strip(),
                    int(rng), 4, float(tension), "pixel.grd")
                # Mira (2026-05-22): in-process grdcut (PRF>=1000 branch).
                if _HAVE_GRDCUT_PY:
                    _grdcut_file("pixel.grd", "tmp.grd", region=str(region))
                else:
                    run("gmt grdcut pixel.grd -R"+str(region)+" -Gtmp.grd")
                file_shuttle('tmp.grd','pixel.grd','mv')
        elif mode == 1:
            rng2 = rng*8
            print('DEM2TOPO_RA: mode == 1 and rng2 is ', rng2)
            run("gmt triangulate temp.rat -R"+str(region)+" -I"+str(rng)+"/4 -bi3d -Gtopo_ra_tmp.grd -r "+str(V))
            run("gmt blockmean temp.rat -R"+str(region)+" -I"+str(rng2)+"/32 -bi3d -bo3d -r > mean.rat")
            _surface_or_run(
                "gmt surface mean.rat -R"+str(region)+" -I"+str(rng2)+"/32 -bi3d -T0.1 -N1000 -Gcoarse.grd -r",
                "mean.rat", str(region), int(rng2), 32, 0.1, "coarse.grd")
            # Mira (2026-05-22): in-process gmt_grdfill_py (-Ag).
            # GMTSAR_GRDFILL_PY=0 → subprocess.
            _grdfill_dispatch("topo_ra_tmp.grd", "pixel.grd", "coarse.grd")
            delete('topo_ra_tmp.grd')
            delete('coarse.grd')
            delete('mean.rat')
        _pt_surface.stop()

    print(' ')
    print('DEM2TOPO_RA: flip top to bottom for both ascending and descending passes ... ...')
    # Mira #30 wire-in: in-process FLIPUD via numpy + gmt_grd_io.
    # Set GMTSAR_GMT_INPROC=0 to fall back to `gmt grdmath`.
    with _dem2topo_phase("flipud"):
        _grdmath_flipud('pixel.grd', 'topo_ra.grd')
    
    print(' ')
    print('DEM2TOPO_RA: plotting ... ...')
    run('gmt grd2cpt topo_ra.grd -Cgray '+str(V)+' -Z > topo_ra.cpt') 
    run('''gmt grdimage topo_ra.grd '''+str(scale)+''' -P -Ctopo_ra.cpt -Bxaf+lRange -Byaf+l"Reversed Azimuth" -BWSen '''+str(V)+''' -K > topo_ra.ps''')
    run("gmt psscale -Rtopo_ra.grd -J -DJTC+w5i/0.2i+h -Ctopo_ra.cpt -Bxaf -By+lm -O >> topo_ra.ps")
    run('gmt psconvert -Tf -P -A -Z topo_ra.ps')
    
    print(' ')
    print("DEM2TOPO_RA: Topo range/azimuth map: topo_ra.pdf")
    
    print(' ')
    print('DEM2TOPO_RA: clean up ... ...')
    delete('pixel.grd')
    delete('temp.grd')
    delete('dem.xyz')
    delete('tmp')
    delete('topo_ra.cpt')

    _dem2topo_dump_profile(path="dem2topo_ra_phase_profile_py.json")

    print(' ')
    print("DEM2TOPO_RA - END ... ...")

