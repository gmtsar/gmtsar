def _grdfill_dispatch(in_grd: str, out_grd: str, donor_grd: str) -> None:
    """Dispatch `gmt grdfill <in> -Ag<donor> -G<out>` to py port or gmt.

    Env gate: GMTSAR_GRDFILL_PY=1 (default, since v2.1.29) → in-process
              numpy port; donor_node_offset-aware (Mira #70), Rule-8
              smoke-verified byte-identical on real ALOS_haiti mode=1 data.
              GMTSAR_GRDFILL_PY=0 → `gmt grdfill` subprocess (rollback).
    """
    use_py = os.environ.get("GMTSAR_GRDFILL_PY", "1") == "1"
    if use_py and _HAVE_GRDFILL_PY:
        _grdfill_py_file(in_grd, out_grd, algorithm='g', donor_path=donor_grd)
    else:
        run(f"gmt grdfill {in_grd} -Ag{donor_grd} -G{out_grd}")


def _advise_sequential(arr):
    """Hint the kernel that this memmap will be read sequentially.

    Mira #35 / #37: under NFS, np.memmap default access is per-4 KB-page
    demand-fault, which triggers a separate NFS RPC for each page.
    MADV_SEQUENTIAL tells the kernel to read-ahead in larger chunks.
    Linux-only; falls back silently on macOS/BSD.
    """
    try:
        m = arr.base
        while m is not None and not isinstance(m, _mmap.mmap):
            m = getattr(m, "base", None)
        if m is None:
            return
        madvise = getattr(m, "madvise", None)
        advice = getattr(_mmap, "MADV_SEQUENTIAL", None)
        if madvise is None or advice is None:
            return
        madvise(advice)
    except (AttributeError, OSError, ValueError):
        pass

