import os
import sys


def gmtsar_sharedir():
    root = os.environ.get('GMTSAR')
    if not root:
        sys.exit("gmtsar_sharedir: $GMTSAR not set")
    print(os.path.join(root, 'share', 'gmtsar'))


if __name__ == "__main__":
    gmtsar_sharedir()
