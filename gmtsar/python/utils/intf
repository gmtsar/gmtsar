import sys, os, subprocess
from gmtsar_lib import * 

def Error_Message():
    print( " ")
    print( "Usage: intf ref.PRM rep.PRM [-topo topogrd] [-model modelgrd]")
    print( " ")
    print( " The dimensions of topogrd and modelgrd should be compatible with SLC file.")
    print( " ")
    print( "Example: intf IMG-HH-ALPSRP055750660-H1.0__A.PRM IMG-HH-ALPSRP049040660-H1.0__A.PRM -topo topo_ra.grd")
    print( " ")

def extractSatBaselineOutputToPrm(refPrm, repPrm):
    # csh command: SAT_baseline $1 $2 | tail -n9 >> $2
    # Routed through shell_check_output (bash -c on Windows) rather than
    # subprocess.run([...]) directly: SAT_baseline_py is an extensionless
    # shebang script -- Windows' CreateProcess can't exec it (it can only
    # auto-append ".exe" to a bare name, and there is no SAT_baseline_py.exe).
    out = shell_check_output(f'SAT_baseline_py {refPrm} {repPrm}')
    output = out.decode('utf-8').split('\n')[-10:]
    print('INTF: SAT_baseline $1 $2 output is ', out)
    print('INTF: tail -n9 the above output is ', output)
    print('INTF: insert the tail results to file ', repPrm)
    with open(repPrm, 'a') as f:
        f.write('\n'.join(output))

    # csh command: SAT_baseline $1 $1 | grep height >> $1
    out = shell_check_output(f'SAT_baseline_py {refPrm} {refPrm}')
    output = out.decode('utf-8')
    output = '\n'.join(line for line in output.split('\n') if 'height' in line)
    with open(refPrm, 'a') as f:
        f.write(output)
        
def intf():
    run('gmt set IO_NC4_CHUNK_SIZE classic')

    n = len(sys.argv)
    arg = sys.argv[1:] # put all the arguments to a list, arg
    # if the # of args is less than 2 (which is n==3 in Python), print error message. 
    if n<3:
        print('FILTER: Wrong # of input arguments; # should be <2 ... ...')
        Error_Message()
    refPrm = sys.argv[1]
    repPrm = sys.argv[2]
    
    SC = int(grep_value(refPrm,'SC_identity',3))
    print('INTF: Retrieve SC_identity = ', SC, ' from the 1st arg ref.PRM ... ...')
    print('INTF: dealing scenarios with different SC ... ...')
    
    if SC==1 or SC==2 or SC==4 or SC==6 or SC==5:
        file_shuttle(repPrm, repPrm+'0', 'cp')
        file_shuttle(refPrm, refPrm+'0', 'cp')
        extractSatBaselineOutputToPrm(refPrm, repPrm)
    elif SC>6:
        file_shuttle(repPrm, repPrm+'0', 'cp')
        file_shuttle(refPrm, refPrm+'0', 'cp')
        extractSatBaselineOutputToPrm(refPrm, repPrm)  
    else:
        print('INTF: ERROR: incorrect satellite id in prm file ... ...')
 
    print('INTF: form the interferogram optionally using topo_ra and modelphase ... ...')
    if n==3 or n==5 or n==7:
        # Mira #41 wire-in (2026-05-22): phasediff_py replaces C phasediff
        # when (a) short-baseline (|baseline_start| <= 1000 m — the py port
        # raises NotImplementedError above that until the long-baseline
        # spline correction is ported, see phasediff_py:447-454), AND
        # (b) GMTSAR_PHASEDIFF_PY != "0". Bit-parity verified on RS2 Hawaii
        # (baseline 43 m): max|d| < 5e-8 vs C in real.grd/imag.grd
        # (87.2% bit-identical, 3.4x faster than C standalone).
        # On long-baseline cases (typical S1 TOPS), falls back to C.
        # Env override: GMTSAR_PHASEDIFF_PY=0  → always C (debug / regression A/B).
        use_py = os.environ.get('GMTSAR_PHASEDIFF_PY', '1') != '0'
        baseline_ok = True
        if use_py:
            try:
                b = float(grep_value(repPrm, 'baseline_start', 3))
                baseline_ok = abs(b) <= 1000.0
                if not baseline_ok:
                    print(f"INTF: |baseline_start|={abs(b):.1f} m > 1000 m → "
                          "falling back to C phasediff (py long-baseline "
                          "spline correction not yet ported).")
            except Exception as e:
                print(f"INTF: WARN baseline lookup failed ({e!r}); "
                      "falling back to C phasediff.")
                baseline_ok = False
        binary = 'phasediff_py' if (use_py and baseline_ok) else 'phasediff'
        cmd = binary
        for i in range(n-1):
            cmd = cmd + ' '+str(arg[i])
        run(cmd)
    else:
        Error_Message()
    
    file_shuttle(refPrm+'0', refPrm, 'mv')
    file_shuttle(repPrm+'0', repPrm, 'mv')
    print("INTF: finishing intf ... ...")

if __name__ == "__main__":
    intf()
