#! /usr/bin/env python3
'''
# p2p_S1_TOPS_Frame is part of GMTSAR. 
# Process Sentinel-1A TOPS data; automatically process a single frame of interferogram. 
'''

import sys, os, glob, time
import subprocess, multiprocessing
from gmtsar_lib import *
# phase_profile is optional — if absent we fall back to no-op stubs so the
# Frame driver still runs in environments without the profiler installed.
try:
    from phase_profile import (phase, dump_profile, time_run as _trun,
                               aggregate_subswath_profiles, _PHASES,
                               _BINARY_TIMES)
    _HAVE_PROFILE = True
except Exception:
    _HAVE_PROFILE = False
    from contextlib import contextmanager
    @contextmanager
    def phase(name):
        yield
    def dump_profile(*a, **kw): pass
    def aggregate_subswath_profiles(*a, **kw): return None
    # _trun fallback must accept (cmd, name=None) like time_run, since the
    # call site in mergeUnwrapGeocodeTops passes a positional name.
    def _trun(cmd, name=None):
        return run(cmd)
    _PHASES = []
    _BINARY_TIMES = {}

