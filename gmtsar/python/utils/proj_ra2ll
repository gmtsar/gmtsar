#
# Purpose: to project a grd file from range/azimuth coordinates into lon/lat coordinates.
#   It takes in
#       - trans.dat, a file generated by llt_grid2rat (r, a, topo, lon, lat)
#       - phase_ra.grd, a GRD file of phase or anything
#   and output
        - phase_ll.grd, a GRD file of phase in longtitude/latitude coordinates

Mira wire-in (v2.3.x): GMTSAR_SURFACE_INPROC gate for the raln/ralt surface
calls (lines ~53/55).  Pattern mirrors proj_ra2ll_lib._run_surface_inproc_5col
(A/B verified float-roundoff-identical at 1.4e-7 RMS vs gmt C on RS2_SLC_Hawaii;
see test_gmt_surface_py.py::TestProjRa2llSurfaceInproc).
Default ON (GMTSAR_SURFACE_INPROC=1); set =0 to fall back to gmt subprocess.
"""

import sys, os, re, configparser
import subprocess, glob, shutil
import numpy as _np
from gmtsar_lib import *

# ---------------------------------------------------------------------------
# In-process gmt surface replacement (gmt_surface_py + gmt_grd_io).
# Gated by GMTSAR_SURFACE_INPROC=1 (default ON since v2.3.x).
# Set GMTSAR_SURFACE_INPROC=0 to fall back to the gmt subprocess.
# ---------------------------------------------------------------------------
try:
    _HERE = os.path.dirname(os.path.abspath(__file__))
    sys.path.insert(0, _HERE)
    from gmt_surface_py import gmt_surface_py as _gmt_surface_py
    from gmt_grd_io import write_gmt_grd as _write_gmt_grd
    _HAVE_SURFACE_PY = True
except Exception as _e:
    _HAVE_SURFACE_PY = False


def _surface_inproc_5col(trans_dat: str, region_str: str, col_z: int,
                          out_path: str) -> None:
    """In-process replacement for:
        gmt surface <trans_dat> -i0,1,<col_z> -bi5d -R<region> -I16/32 -T.50 -G<out>

    Reads trans_dat (binary 5-col float64), extracts cols 0 (x), 1 (y),
    col_z (z), calls gmt_surface_py with gridline registration (omits -r),
    and writes via gmt_grd_io.write_gmt_grd.

    Raises on failure — no silent fallback (Rule 12).  Caller (_ensure_raln_ralt_inproc)
    gates on GMTSAR_SURFACE_INPROC and _HAVE_SURFACE_PY.
    """
    rs = region_str.replace("-R", "").strip()
    parts = rs.split("/")
    if len(parts) != 4:
        raise ValueError(f"proj_ra2ll: bad region '{region_str}'")
    x0, x1, y0, y1 = (float(p) for p in parts)

    data = _np.fromfile(trans_dat, dtype=_np.float64)
    if data.size % 5 != 0:
        raise ValueError(f"{trans_dat}: size {data.size} not divisible by 5 float64s")
    data = data.reshape(-1, 5)
    x = data[:, 0]; y = data[:, 1]; z = data[:, col_z]

    grid = _gmt_surface_py(
        x, y, z,
        region=(x0, x1, y0, y1),
        inc=(16.0, 32.0),
        tension=0.5,
        max_iter=2000, tol=1e-4,
        omega=0.5,
        use_multigrid=True,
        pixel_reg=False,   # gridline registration (no -r in original command)
    )
    ny, nx = grid.shape
    x_coord = x0 + _np.arange(nx) * 16.0
    y_coord = y0 + _np.arange(ny) * 32.0
    _write_gmt_grd(out_path, grid, x_coord, y_coord, node_offset=0,
                   history=(f"gmt_surface_py (-T0.5) -I16/32 (col {col_z}) "
                             "[proj_ra2ll GMTSAR_SURFACE_INPROC=1]"))


def _ensure_raln_ralt_inproc(trans_dat: str, region: str, V: str) -> None:
    """Build raln.grd / ralt.grd if either is missing.

    Env gate: GMTSAR_SURFACE_INPROC=1 (default ON) -> _surface_inproc_5col;
              GMTSAR_SURFACE_INPROC=0 -> gmt surface subprocess (legacy path).

    A/B verification (RS2_SLC_Hawaii, 2026-06-18):
      gmt_surface_py vs gmt surface -i0,1,3 -bi5d -R0/3424/0/5760 -I16/32 -T.50:
      interior RMS = 1.4e-7 degrees, max|d| = 1.5e-5 degrees -- float-roundoff identical.
    """
    inproc = (os.environ.get("GMTSAR_SURFACE_INPROC", "1") == "1"
              and _HAVE_SURFACE_PY)
    if not os.path.isfile("raln.grd"):
        if inproc:
            _surface_inproc_5col(trans_dat, region, col_z=3, out_path="raln.grd")
        else:
            run(f"gmt surface {trans_dat} -i0,1,3 -bi5d {region} -I16/32 -T.50 -Graln.grd {V}")
    if not os.path.isfile("ralt.grd"):
        if inproc:
            _surface_inproc_5col(trans_dat, region, col_z=4, out_path="ralt.grd")
        else:
            run(f"gmt surface {trans_dat} -i0,1,4 -bi5d {region} -I16/32 -T.50 -Gralt.grd {V}")


def proj_ra2ll():

    def Error_Message():
        print( " ")
        print( "Usage: proj_ra2ll trans.dat phase.grd phase_ll.grd [filter_wavelength] ")
        print( " ")
        print( " trans.dat    - file generated by llt_grid2rat  (r a topo lon lat) ")
        print( " phase_ra.grd - a GRD file of phase or anything ")
        print( " phase_ll.grd - output file in lon/lat-coordinates ")
        print( " filter_wavelength - will sample every 1/4 wavelength (in meters) ")
        print( " ")

    print('PROJ_RA2ll - START ... ...')
    n = len(sys.argv)
    print('PROJ_RA2ll: input arguments are ', sys.argv)

    if n!=4 and n!=5:
        print('FILTER: Wrong # of input arguments; # should be 3 or 4 ... ...')
        Error_Message()

    V = '-V'

    print(' ')
    print('PROJ_RA2ll: extract the phase in the r a positions ... ...')
    run('gmt grd2xyz '+sys.argv[2]+' -s -bo3f > rap')

    print(' ')
    print('PROJ_RA2ll: make grids of longitude and latitude versus range and azimuth unless they already exist ... ...')

    if check_file_report('raln.grd')==False or check_file_report('ralt.grd')==False:
        #region = subprocess.check_output(["gmt","gmtinfo","rap","-I16/32","-bi3f"], universal_newlines=True)
        region = catch_output_cmd(["gmt","gmtinfo","rap","-I16/32","-bi3f"],False,0,-10000)
        print('PROJ_RA2ll: region is ', region)

        _ensure_raln_ralt_inproc(sys.argv[1], region, V)
        
    print(' ')
    print('PROJ_RA2ll: add lon and lat columns and then just keep lon, lat, phase ... ...')
    
    run('gmt grdtrack rap -nl -bi3f -bo5f -Graln.grd -Gralt.grd | gmt gmtconvert -bi5f -bo3f -o3,4,2 > llp')
    
    print('PROJ_RA2ll: set the output grid spaccing to be 1/4 the filter wavelength ... ...')
    
    if n==5:
        filt_wave = float(sys.argv[4])
        pix_m     = filt_wave/4
        print('PROJ_RA2ll: Sampling in geocoordinates with '+str(pix_m)+' meter pixels ... ...')
    else:
        filt = glob.glob("gauss_*")
        if filt!=[]:
            res = filt[0][6:] # extract resolution from gauss_* string.
            pix_m = float(res)/4
            # use 1/4 wavelength
            print('PROJ_RA2ll: Sampling in geocoordinates with '+str(pix_m)+' meter pixels ...')
        else:
            pix_m = 60
            print('PROJ_RA2ll: Sampling in geocoordinates with deault ('+str(pix_m)+' meter) pixel size ... ...')
    
    incs = subprocess.run(["m2s.csh",str(pix_m),"llp"],stdout=subprocess.PIPE).stdout.decode('utf-8').strip().split()
    print('PROJ_RA2ll: incs is ', incs)
    R    = subprocess.run(["gmt","gmtinfo","llp","-I"+incs[1],"-bi3f"], stdout=subprocess.PIPE).stdout.decode('utf-8').strip()
    
    print('PROJ_RA2ll: R is ', R)
    
    cmd = 'gmt blockmedian llp '+R+' -bi3f -bo3f -I'+incs[0]+" -r -V > llpb"
    run(cmd)
    cmd = 'gmt xyz2grd llpb '+R+' -I'+incs[0]+'  -r -fg -G'+sys.argv[3]+' -bi3f'
    run(cmd)
    run('rm rap* llp llpb raln ralt')
    
    print("PROJ_RA2ll - END ... ...")

if __name__ == "__main__":
    proj_ra2ll()
