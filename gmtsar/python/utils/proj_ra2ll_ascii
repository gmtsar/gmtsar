#! /usr/bin/env python3
"""proj_ra2ll_ascii — ASCII variant of proj_ra2ll.

Python port of csh proj_ra2ll_ascii.csh (D. Sandwell 2007).

Usage:  proj_ra2ll_ascii trans.dat phase_ra.txt phase_ll.txt

Inputs:
  trans.dat        — file generated by SAT_llt2rat (r a topo lon lat)
  phase_ra.txt     — ASCII file of (range azimuth value)
Output:
  phase_ll.txt     — ASCII file of (lon lat value)

The raln.grd / ralt.grd intermediate files are kept if they already exist,
so calling this repeatedly with the same trans.dat is cheap.

Mira wire-in (v2.3.x): GMTSAR_SURFACE_INPROC gate for the raln/ralt surface
calls.  Both the gmtconvert step (5d -> 3f) and the gmt surface call are
replaced in-process by reading trans.dat directly as float64 and calling
gmt_surface_py.  A/B verified float-roundoff-identical at 4.4e-6 RMS vs
gmt surface -bi3f -I8/32 -T.50 on RS2_SLC_Hawaii (see
test_gmt_surface_py.py::TestProjRa2llAsciiSurfaceInproc).
Default ON (GMTSAR_SURFACE_INPROC=1); set =0 to fall back to gmt subprocess.
"""
import os
import sys
import numpy as _np
from gmtsar_lib import run, catch_output_cmd

# ---------------------------------------------------------------------------
# In-process gmt surface replacement (gmt_surface_py + gmt_grd_io).
# Gated by GMTSAR_SURFACE_INPROC=1 (default ON since v2.3.x).
# Set GMTSAR_SURFACE_INPROC=0 to fall back to the gmt subprocess.
# ---------------------------------------------------------------------------
try:
    _HERE = os.path.dirname(os.path.abspath(__file__))
    sys.path.insert(0, _HERE)
    from gmt_surface_py import gmt_surface_py as _gmt_surface_py
    from gmt_grd_io import write_gmt_grd as _write_gmt_grd
    _HAVE_SURFACE_PY = True
except Exception:
    _HAVE_SURFACE_PY = False


def _surface_inproc_5col_to_grd(trans_dat: str, region_str: str,
                                  col_z: int, inc_x: float, inc_y: float,
                                  out_path: str) -> None:
    """In-process replacement for the csh two-step:
        gmt gmtconvert <trans_dat> -o0,1,<col_z> -bi5d -bo3f > tmp
        gmt surface tmp -R<region> -bi3f -I<inc_x>/<inc_y> -T.50 -G<out>

    Reads trans_dat (binary 5-col float64 as written by SAT_llt2rat -bod),
    extracts cols 0 (x), 1 (y), col_z (z), casts to float32 to match what
    gmt gmtconvert -bo3f + gmt surface -bi3f would read, then calls
    gmt_surface_py with gridline registration (original commands omit -r).
    Writes via gmt_grd_io.write_gmt_grd.

    Raises on failure -- no silent fallback (Rule 12).
    """
    rs = region_str.replace("-R", "").strip()
    parts = rs.split("/")
    if len(parts) != 4:
        raise ValueError(f"proj_ra2ll_ascii: bad region '{region_str}'")
    x0, x1, y0, y1 = (float(p) for p in parts)

    data = _np.fromfile(trans_dat, dtype=_np.float64)
    if data.size % 5 != 0:
        raise ValueError(
            f"{trans_dat}: size {data.size} not divisible by 5 float64s")
    data = data.reshape(-1, 5)
    # Cast to float32 to match what gmt gmtconvert -bo3f + gmt surface -bi3f
    # would read.  The surface algorithm then sees the same quantised values
    # as the gmt C path.
    x = data[:, 0].astype(_np.float32).astype(_np.float64)
    y = data[:, 1].astype(_np.float32).astype(_np.float64)
    z = data[:, col_z].astype(_np.float32).astype(_np.float64)

    grid = _gmt_surface_py(
        x, y, z,
        region=(x0, x1, y0, y1),
        inc=(inc_x, inc_y),
        tension=0.5,
        max_iter=2000, tol=1e-4,
        omega=0.5,
        use_multigrid=True,
        pixel_reg=False,   # gridline registration (original command omits -r)
    )
    ny, nx = grid.shape
    x_coord = x0 + _np.arange(nx) * inc_x
    y_coord = y0 + _np.arange(ny) * inc_y
    _write_gmt_grd(out_path, grid, x_coord, y_coord, node_offset=0,
                   history=(f"gmt_surface_py (-T0.5) "
                             f"-I{inc_x}/{inc_y} (col {col_z}) "
                             "[proj_ra2ll_ascii GMTSAR_SURFACE_INPROC=1]"))


def proj_ra2ll_ascii():
    if len(sys.argv) < 4:
        sys.exit(
            "Usage: proj_ra2ll_ascii trans.dat phase_ra.txt phase_ll.txt\n"
            "  trans.dat    - file generated by SAT_llt2rat (r a topo lon lat)\n"
            "  phase_ra.txt - input ASCII file of (range azimuth value)\n"
            "  phase_ll.txt - output ASCII file of (lon lat value)"
        )
    trans, phase_ra, phase_ll = sys.argv[1], sys.argv[2], sys.argv[3]
    V = "" if os.path.isfile(os.path.expanduser("~/.quiet")) else "-V"

    inproc = (os.environ.get("GMTSAR_SURFACE_INPROC", "1") == "1"
              and _HAVE_SURFACE_PY)

    if not (os.path.isfile("raln.grd") and os.path.isfile("ralt.grd")):
        # Compute region from phase_ra extent; phase_ra is ASCII so no -bi flag
        region = catch_output_cmd(
            ["gmt", "gmtinfo", phase_ra, "-I16/32"], False, 0, -10000)
        if inproc:
            _surface_inproc_5col_to_grd(trans, region, col_z=3,
                                         inc_x=8.0, inc_y=32.0,
                                         out_path="raln.grd")
            _surface_inproc_5col_to_grd(trans, region, col_z=4,
                                         inc_x=8.0, inc_y=32.0,
                                         out_path="ralt.grd")
        else:
            run(f"gmt gmtconvert {trans} -o0,1,3 -bi5d -bo3f > raln")
            run(f"gmt gmtconvert {trans} -o0,1,4 -bi5d -bo3f > ralt")
            run(f"gmt surface raln {region} "
                f"-bi3f -I8/32 -T.50 -Graln.grd {V}")
            run(f"gmt surface ralt {region} "
                f"-bi3f -I8/32 -T.50 -Gralt.grd {V}")

    # Sample lon, lat at each (range, azimuth) point; output (lon lat value)
    run(f"gmt grdtrack {phase_ra} -nl -Graln.grd -Gralt.grd -o3,4,2 > {phase_ll}")
    run("rm -f rap* llp llpb")


if __name__ == "__main__":
    proj_ra2ll_ascii()
